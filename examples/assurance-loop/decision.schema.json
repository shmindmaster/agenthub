{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenthub.dev/schemas/assurance-decision-v1.json",
  "title": "AgentHub assurance decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "decisionId", "intent", "action", "resource", "risk", "evidenceRefs", "expectedOutcome"],
  "properties": {
    "contractVersion": { "const": 1 },
    "decisionId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "intent": { "type": "string", "minLength": 1, "maxLength": 240 },
    "action": { "const": "workspace.write" },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "content"],
      "properties": {
        "kind": { "const": "file" },
        "path": { "type": "string", "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$" },
        "content": { "type": "string", "maxLength": 4096 }
      }
    },
    "risk": { "enum": ["low", "medium", "high"] },
    "evidenceRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 240 } },
    "expectedOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "sha256"],
      "properties": {
        "kind": { "const": "file" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
