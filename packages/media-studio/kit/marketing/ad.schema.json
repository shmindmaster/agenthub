{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "mvg ad spec",
  "description": "One ad spec file in, gated 16:9 / 4:5 / 9:16 ads out. Written within the JSON-Schema subset lib/schema.mjs validates.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "product", "audience", "objective", "voice", "claims", "labels"],
  "anyOf": [
    { "required": ["ratios", "targetSeconds", "beats"] },
    { "required": ["cuts"] }
  ],
  "properties": {
    "communicationProfile": {"enum": ["consulting-demo", "technical-walkthrough", "product-update"]},
    "primaryAudience": {"type": "string", "minLength": 1},
    "viewerDecision": {"type": "string", "minLength": 1},
    "primaryTakeaway": {"type": "string", "minLength": 1},
    "audienceContext": {"type": "object", "additionalProperties": false, "required": ["problemStatus", "sourceRefs"], "properties": {"problemStatus": {"enum": ["confirmed-discovery", "hypothesis", "fictional-scenario"]}, "sourceRefs": {"type": "array", "items": {"type": "string", "minLength": 1}}}},
    "nextStep": {"type": "object", "additionalProperties": false, "required": ["action", "owner", "agreedDate"], "properties": {"action": {"type": "string", "minLength": 1}, "owner": {"type": "string", "minLength": 1}, "agreedDate": {"type": ["string", "null"]}, "sourceRefs": {"type": "array", "items": {"type": "string", "minLength": 1}}}},
    "maxDurationSeconds": {"type": "number", "minimum": 1},
    "finalHoldSeconds": {"type": "number", "minimum": 0, "maximum": 30},
    "captionPolicy": {"type": "object", "additionalProperties": false, "required": ["mode", "deliverySurface"], "properties": {"mode": {"enum": ["selectable", "open", "sidecar"]}, "deliverySurface": {"type": "string", "minLength": 1}}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "scenarioRecord": {"type": "string", "minLength": 1},
    "integrationFlow": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "integrationStatus": {"enum": ["demonstrated-adapter", "file-import", "proposed"]},
    "audioDirection": {"type": "object", "additionalProperties": false, "required": ["narratorIdentity", "pronunciationRefs", "delivery", "emphasis", "pauses", "musicTreatment"], "properties": {"narratorIdentity": {"type": "string", "minLength": 1}, "pronunciationRefs": {"type": "array", "items": {"type": "string", "minLength": 1}}, "delivery": {"type": "string", "minLength": 1}, "emphasis": {"type": "array", "items": {"type": "string", "minLength": 1}}, "pauses": {"type": "string", "minLength": 1}, "musicTreatment": {"enum": ["none", "restrained-bed", "compare-bed-and-silence"]}}},
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,62}$" },
    "title": { "type": "string", "minLength": 3, "maxLength": 90 },
    "product": { "type": "string", "minLength": 2 },
    "audience": { "type": "string", "minLength": 3 },
    "objective": { "type": "string", "minLength": 3 },
    "concept": { "type": "string" },
    "creativeMode": { "enum": ["verified-demo", "hybrid", "future-vision", "concept-film", "fictional-story", "explainer", "documentary", "educational", "abstract"], "description": "Film intent and reality contract. Omitted for existing verified product demo ads." },
    "conceptDisclosure": { "type": "string", "description": "Truthful concept/vision labeling when proposed functionality is depicted. May be in labels, on an end card, or prominent narration; does not mandate watermark or blur." },
    "syntheticData": { "type": "boolean", "description": "Data are synthetic. May be disclosed at film level; no automatic privacy blur." },
    "filmType": { "enum": ["product-marketing", "feature-demo", "tutorial", "explainer", "social-cut", "founder-pitch", "internal-update", "story", "non-narrative"], "description": "The form the story gate judges this film by. Defaults from creativeMode (verified-demo and hybrid: product-marketing). A cut may set its own." },
    "organizingPrinciple": { "type": "string", "minLength": 12, "description": "Required for a non-narrative film: what orders the shots and what the viewer should leave with." },
    "storyOverrides": { "type": "array", "description": "Story rules waived for this film, each with the reason. A waived rule is logged as a warning instead of failing. Only story.* rules can be waived; truth and evidence rules cannot.", "items": { "type": "object", "additionalProperties": false, "required": ["rule", "reason"], "properties": { "rule": { "type": "string", "pattern": "^story\\.[A-Za-z0-9.*-]+$" }, "reason": { "type": "string", "minLength": 12 }, "decidedBy": { "type": "string" }, "date": { "type": "string" } } } },
    "narrative": { "$ref": "#/definitions/narrative", "description": "The brief. Which fields are required depends on filmType; the lint reports the missing ones." },
    "hookPlan": { "$ref": "#/definitions/hookPlan", "description": "Aligned first picture, on-screen message, spoken hook and viewer question. Required for a full product-marketing cut." },
    "brand": { "type": "string", "description": "Path to the brand file, relative to the spec or absolute. Default: ../brand/brand.json" },
    "ratios": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/definitions/ratio" } },
    "targetSeconds": { "type": "number", "minimum": 5, "maximum": 900 },
    "cuts": {
      "type": "array", "minItems": 1,
      "description": "Distinct cuts of one ad (for example a 20 s main cut and a 12 s vertical cut). Ratios must not repeat across cuts.",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "ratios", "targetSeconds", "beats"],
        "properties": {
          "communicationProfile": {"enum": ["consulting-demo", "technical-walkthrough", "product-update"]},
          "primaryAudience": {"type": "string", "minLength": 1},
          "viewerDecision": {"type": "string", "minLength": 1},
          "primaryTakeaway": {"type": "string", "minLength": 1},
          "audienceContext": {"type": "object", "additionalProperties": false, "required": ["problemStatus", "sourceRefs"], "properties": {"problemStatus": {"enum": ["confirmed-discovery", "hypothesis", "fictional-scenario"]}, "sourceRefs": {"type": "array", "items": {"type": "string", "minLength": 1}}}},
          "nextStep": {"type": "object", "additionalProperties": false, "required": ["action", "owner", "agreedDate"], "properties": {"action": {"type": "string", "minLength": 1}, "owner": {"type": "string", "minLength": 1}, "agreedDate": {"type": ["string", "null"]}, "sourceRefs": {"type": "array", "items": {"type": "string", "minLength": 1}}}},
          "maxDurationSeconds": {"type": "number", "minimum": 1},
          "finalHoldSeconds": {"type": "number", "minimum": 0, "maximum": 30},
          "captionPolicy": {"type": "object", "additionalProperties": false, "required": ["mode", "deliverySurface"], "properties": {"mode": {"enum": ["selectable", "open", "sidecar"]}, "deliverySurface": {"type": "string", "minLength": 1}}},
          "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "scenarioRecord": {"type": "string", "minLength": 1},
          "integrationFlow": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "integrationStatus": {"enum": ["demonstrated-adapter", "file-import", "proposed"]},
          "audioDirection": {"type": "object", "additionalProperties": false, "required": ["narratorIdentity", "pronunciationRefs", "delivery", "emphasis", "pauses", "musicTreatment"], "properties": {"narratorIdentity": {"type": "string", "minLength": 1}, "pronunciationRefs": {"type": "array", "items": {"type": "string", "minLength": 1}}, "delivery": {"type": "string", "minLength": 1}, "emphasis": {"type": "array", "items": {"type": "string", "minLength": 1}}, "pauses": {"type": "string", "minLength": 1}, "musicTreatment": {"enum": ["none", "restrained-bed", "compare-bed-and-silence"]}}},
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,30}$" },
          "ratios": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/definitions/ratio" } },
          "targetSeconds": { "type": "number", "minimum": 5, "maximum": 900 },
          "beats": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/beat" } },
          "narrative": { "$ref": "#/definitions/narrative" },
          "hookPlan": { "$ref": "#/definitions/hookPlan" },
          "filmType": { "enum": ["product-marketing", "feature-demo", "tutorial", "explainer", "social-cut", "founder-pitch", "internal-update", "story", "non-narrative"] },
          "organizingPrinciple": { "type": "string", "minLength": 12 },
          "storyOverrides": { "type": "array", "description": "Story rules waived for this film, each with the reason. A waived rule is logged as a warning instead of failing. Only story.* rules can be waived; truth and evidence rules cannot.", "items": { "type": "object", "additionalProperties": false, "required": ["rule", "reason"], "properties": { "rule": { "type": "string", "pattern": "^story\\.[A-Za-z0-9.*-]+$" }, "reason": { "type": "string", "minLength": 12 }, "decidedBy": { "type": "string" }, "date": { "type": "string" } } } }
        }
      }
    },
    "voice": { "$ref": "#/definitions/voice" },
    "render": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "lineChips": { "type": "boolean", "description": "False disables the burned caption/line-chip layer, not the sidecar SRT." },
        "captions": { "type": "boolean", "description": "False disables burned captions; accessible sidecar captions remain." }
      }
    },
    "music": {
      "type": "object", "additionalProperties": false,
      "required": ["provider"],
      "properties": {
        "provider": { "enum": ["elevenlabs", "none"] },
        "prompt": { "type": "string", "minLength": 10 },
        "licenseBasis": { "type": "string", "minLength": 10 },
        "bedDb": { "type": "number", "minimum": -40, "maximum": -10 },
        "lengthSeconds": { "type": "number", "minimum": 3, "description": "Fixed bed length. Jobs with the same prompt, model and lengthSeconds make an identical request and reuse one track instead of buying one per job length. Must be at least the longest cut plus 2 s (the mix trims the bed to the program, never extends it); default is the longest cut plus 2 s per job." },
        "model": { "type": "string" }
      }
    },
    "beats": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/beat" } },
    "cta": {
      "description": "The one ask. Required by the lint for a film that sells (filmType product-marketing or founder-pitch) and for a spec that declares no filmType; optional for the other declared film types.",
      "type": "object", "additionalProperties": false,
      "required": ["text", "url"],
      "properties": {
        "text": { "type": "string", "minLength": 3, "maxLength": 80 },
        "url": { "type": "string", "pattern": "^https://[^\\s]+$" },
        "displayUrl": { "type": "string" },
        "claim": { "type": "string" }
      }
    },
    "claims": {
      "type": "array", "minItems": 0,
      "description": "Current factual assertions made by the ad. Leave empty when the ad makes none.",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "text", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,40}$" },
          "text": { "type": "string", "minLength": 3 },
          "phrases": { "type": "array", "items": { "type": "string", "minLength": 2 } },
          "kind": { "enum": ["assertion", "stance", "cta"] },
          "evidence": {
            "type": "string", "minLength": 6,
            "description": "file:<path>[:line] | clip:<sourceJob>#<clipId>@<t0>-<t1> | approved:<source>"
          }
        }
      }
    },
    "labels": { "type": "string", "minLength": 0, "description": "Optional branding/film-wide disclosure text. Concepts may be declared by labels or conceptDisclosure; film modes do not impose blur or repeated watermarks." },
    "budget": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "elevenlabsCredits": { "type": "integer", "minimum": 0 },
        "openaiUsd": { "type": "number", "minimum": 0 },
        "assemblyaiUsd": { "type": "number", "minimum": 0 },
        "deepgramUsd": { "type": "number", "minimum": 0 },
        "runwareUsd": { "type": "number", "minimum": 0 },
        "azureUsd": { "type": "number", "minimum": 0 }
      }
    },
    "edit": {
      "type": "object", "additionalProperties": false,
      "description": "Editing rules that are not part of any one beat.",
      "properties": {
        "beatGrid": {
          "type": "object", "additionalProperties": false, "required": ["bpm", "offsetSeconds"],
          "description": "The music bed's tempo. The bed plays from program time 0, so beats fall at offsetSeconds + n * 60/bpm. After the voice-first timeline is built, every scene boundary but the start is held (tail only) to the next beat, so cuts land on the grid the marketing-readiness floor measures. Lives here, never in music, so the bed's cache key is unaffected.",
          "properties": {
            "bpm": { "type": "number", "minimum": 40, "maximum": 220 },
            "offsetSeconds": { "type": "number", "minimum": 0, "maximum": 10 }
          }
        }
      }
    },
    "qa": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "storyMin": { "type": "number", "minimum": 0, "maximum": 100 },
        "visionEverySeconds": { "type": "number", "minimum": 0.5, "maximum": 5 },
        "loudness": { "enum": ["social", "web"] },
        "required": { "type": "array", "items": { "enum": ["picture", "integrity", "pointer", "frameIntegrity", "captions", "loudness", "sync", "listen", "vision", "marketing", "story", "viewerRelease", "wordSync", "transcript"] } }
      }
    },
    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "definitions": {
    "hookPlan": {
      "type": "object", "additionalProperties": { "type": "string" },
      "description": "Describe picture, visible text, spoken hook and open question. Spoken hook must match the actual first narration beat.",
      "properties": {
        "visual": { "type": "string", "minLength": 6 },
        "onScreen": { "type": "string", "minLength": 6 },
        "spoken": { "type": "string", "minLength": 6 },
        "viewerQuestion": { "type": "string", "minLength": 6 },
        "alternatives": {
          "type": "array", "maxItems": 3,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["angle", "visual", "spoken"],
            "properties": {
              "angle": { "type": "string", "minLength": 3 },
              "visual": { "type": "string", "minLength": 6 },
              "spoken": { "type": "string", "minLength": 6 }
            }
          }
        },
        "selectionReason": { "type": "string", "minLength": 6 }
      }
    },
    "narrative": {
      "type": "object", "additionalProperties": { "type": "string" },
      "description": "A grounded buyer-facing story brief. The lint also requires stage-coded beats and the actual software introduction.",
      "properties": {
        "persona": { "type": "string", "minLength": 6 },
        "situation": { "type": "string", "minLength": 6 },
        "trigger": { "type": "string", "minLength": 6 },
        "problem": { "type": "string", "minLength": 6 },
        "stakes": { "type": "string", "minLength": 6 },
        "solution": { "type": "string", "minLength": 6 },
        "mechanism": { "type": "string", "minLength": 6 },
        "payoff": { "type": "string", "minLength": 6 },
        "emotionalBefore": { "type": "string", "minLength": 6, "description": "Specific felt cost or uncertainty before the solution, not invented drama." },
        "emotionalAfter": { "type": "string", "minLength": 6, "description": "Credible emotional change after the demonstrated outcome." },
        "viewerValue": { "type": "string", "minLength": 6, "description": "One useful takeaway or result delivered before the CTA." }
      }
    },
    "ratio": { "enum": ["16x9", "4x5", "9x16"] },
    "voice": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "voiceId", "model"],
      "properties": {
        "provider": { "enum": ["elevenlabs", "openai", "local", "import"], "description": "import: narration already made by a governed script or recorded by a person, read from voice.manifest (media-studio/narration-import/1). No provider is called and nothing is charged." },
        "source": { "enum": ["assemblyai", "deepgram", "azure", "openai", "elevenlabs", "recording"], "description": "provider import only: who made the audio. recording is a human recording (not AI-generated); every other source is AI-generated and needs a disclosure." },
        "manifest": { "type": "string", "minLength": 1, "description": "provider import only: path of the import manifest, relative to the spec folder. Audio files must sit inside the manifest's folder." },
        "aiGenerated": { "type": "boolean", "description": "provider import only: optional restatement; it must agree with source (false only for a recording)." },
        "entityException": { "type": "object", "additionalProperties": false, "required": ["reason", "approvedBy"], "description": "provider import only: lets an import whose entity differs from the brand entity proceed; recorded in the ledger note.", "properties": { "reason": { "type": "string", "minLength": 8 }, "approvedBy": { "type": "string", "minLength": 2 } } },
        "voiceId": { "type": "string", "minLength": 2 },
        "name": { "type": "string" },
        "model": { "type": "string", "minLength": 2 },
        "settings": {
          "type": "object",
          "description": "ElevenLabs voice_settings (v4: stability and similarity_boost only) plus apply_text_normalization.",
          "properties": {
            "stability": { "type": "number", "minimum": 0, "maximum": 1 },
            "similarity_boost": { "type": "number", "minimum": 0, "maximum": 1 },
            "style": { "type": "number", "minimum": 0, "maximum": 1 },
            "speed": { "type": "number", "minimum": 0.7, "maximum": 1.2 },
            "use_speaker_boost": { "type": "boolean" },
            "apply_text_normalization": { "enum": ["auto", "on", "off"] }
          }
        },
        "instructions": { "type": "string", "description": "OpenAI speech style instructions." },
        "stitching": { "type": "boolean", "description": "Send previous_text/next_text so prosody carries across lines (not on eleven_v3)." },
        "pronunciationDictionaries": {
          "type": "array", "maxItems": 3,
          "items": { "type": "object", "additionalProperties": false, "required": ["id", "version"],
                     "properties": { "id": { "type": "string" }, "version": { "type": "string" } } }
        },
        "disclosure": { "type": "string", "description": "Where the AI-voice disclosure appears. Required for OpenAI voices." },
        "ownerVoice": { "type": "boolean", "description": "True only for an ElevenLabs job whose owner manifest names this voiceId, with a stated disclosure. Lint refuses it otherwise." }
      }
    },
    "beat": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "actionTitle": {"type": "string", "minLength": 12, "maxLength": 160},
        "supportingArgument": {"type": "string", "minLength": 1},
        "proofRefs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "evidenceClaims": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["text", "scope", "sourceRefs", "implementationState", "dataType", "aiExecutionMode", "businessValidation"], "properties": {"text": {"type": "string", "minLength": 1}, "scope": {"enum": ["product-behavior", "measured-benefit", "proposed-interface", "customer-priority", "illustrative-scenario"]}, "sourceRefs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "implementationState": {"enum": ["implemented", "proposed"]}, "dataType": {"enum": ["synthetic", "customer", "public"]}, "aiExecutionMode": {"enum": ["live", "recorded", "stubbed", "none"]}, "businessValidation": {"enum": ["unvalidated", "measured", "discovery-confirmed"]}, "visibleLabel": {"type": "string", "minLength": 1}, "measurement": {"type": "object", "additionalProperties": false, "required": ["baseline", "comparison", "population", "method", "timeWindow"], "properties": {"baseline": {"type": "string", "minLength": 1}, "comparison": {"type": "string", "minLength": 1}, "population": {"type": "string", "minLength": 1}, "method": {"type": "string", "minLength": 1}, "timeWindow": {"type": "string", "minLength": 1}}}}}},
        "uiProof": {"type": "object", "additionalProperties": false, "required": ["actor", "object", "action", "systemResponse", "result", "significance"], "properties": {"screen": {"type": "string", "minLength": 1}, "control": {"type": "string", "minLength": 1}, "actor": {"type": "string", "minLength": 1}, "object": {"type": "string", "minLength": 1}, "action": {"type": "string", "minLength": 1}, "systemResponse": {"type": "string", "minLength": 1}, "result": {"type": "string", "minLength": 1}, "significance": {"type": "string", "minLength": 1}}},
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,30}$" },
        "kind": { "enum": ["ui", "broll", "card", "title"] },
        "truthStatus": { "enum": ["verified", "proposed", "fictional", "illustrative"], "description": "Representation of this beat. Generated future UIs and story reenactments are permitted when appropriately classified." },
        "storyRole": { "type": "string", "minLength": 2, "maxLength": 40, "description": "The part this beat plays: hook, context, problem, solution, demonstration, proof, payoff, cta, goal, step, explanation, takeaway, recap, next-step, or an accepted alias such as context-problem, product-introduction, call-to-action. Which roles a film needs depends on filmType." },
        "narration": { "type": "string" },
        "onScreenText": { "type": "string", "maxLength": 80 },
        "emphasis": { "type": "array", "items": { "type": "string" }, "description": "Words in the narration highlighted in the kinetic captions." },
        "claims": { "type": "array", "items": { "type": "string" }, "description": "Claim ids this beat's narration and on-screen text rely on." },
        "minSeconds": { "type": "number", "minimum": 0.5, "maximum": 20 },
        "captionPlacement": { "enum": ["bottom", "top"], "description": "Where this beat's caption plate sits. Default bottom; top when the bottom of the frame holds the product content the line is about (the top safe area then carries the plate)." },
        "voiceTake": { "type": "integer", "minimum": 1, "maximum": 20, "description": "Ask for a fresh take of this line (new cache key and ledger revision) after a listen or review rejects its delivery." },
        "ui": {
          "type": "object", "additionalProperties": false,
          "required": ["sourceJob", "clipId"],
          "properties": {
            "sourceJob": { "type": "string", "description": "Existing film workspace holding capture/receipt.json and capture/clips." },
            "clipId": { "type": "string" },
            "trimStart": { "type": "number", "minimum": 0 },
            "trimEnd": { "type": "number", "minimum": 0 },
            "record": { "type": "boolean", "description": "(Re)record this clip with record-job.mjs (needs --allow-capture and a scene function in the source job)." },
            "actions": {
              "type": "array",
              "description": "Narrated pointer actions for the sync gate: the receipt action label and the spoken keywords that name it.",
              "items": { "type": "object", "additionalProperties": false, "required": ["label", "keywords"], "properties": { "label": { "type": "string" }, "keywords": { "type": "array", "minItems": 1, "items": { "type": "string" } } } }
            },
            "freshness": { "enum": ["current", "recapture-recommended"], "description": "recapture-recommended: the clip predates a product change that touches this screen." },
            "freshnessNote": { "type": "string" },
            "focus": {
              "type": "array",
              "description": "Explicit focus windows in clip seconds with the target's normalized position in the clip frame. Required when the clip has Recast zoom (clicks).",
              "items": {
                "type": "object", "additionalProperties": false, "required": ["startSec", "endSec", "x", "y"],
                "properties": {
                  "startSec": { "type": "number", "minimum": 0 }, "endSec": { "type": "number", "minimum": 0 },
                  "x": { "type": "number", "minimum": 0, "maximum": 1 }, "y": { "type": "number", "minimum": 0, "maximum": 1 },
                  "zoom": { "type": "number", "minimum": 1, "maximum": 3 },
                  "declaredZoom": { "type": "boolean", "description": "The cue sheet declares this zoom beat; allowed only on a device-scale recording so the zoomed region is not upscaled (picture integrity)." },
                  "sourceZoom": { "type": "number", "minimum": 1, "maximum": 3, "description": "Recast punch-in already present in the clip at this time; text is that much larger than the crop alone suggests." },
                  "label": { "type": "string" }
                }
              }
            }
          }
        },
        "broll": {
          "type": "object", "additionalProperties": false, "required": ["provider", "prompt"],
          "properties": {
            "provider": { "enum": ["openai-image", "elevenlabs-video", "stock", "import"], "description": "elevenlabs-video has no governed adapter and stock without a file cannot be produced: both fail the lint. import: a still made by a governed script (Runware, Azure) or licensed, supplied as file + sha256." },
            "prompt": { "type": "string", "minLength": 10 },
            "file": { "type": "string", "description": "stock and import: a still image (png, jpg or webp), relative to the spec folder." },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "import: SHA-256 of file." },
            "source": { "enum": ["runware", "azure", "openai", "licensed"], "description": "import: who made the still." },
            "model": { "type": "string" },
            "entityException": { "type": "object", "additionalProperties": false, "required": ["reason", "approvedBy"], "properties": { "reason": { "type": "string", "minLength": 8 }, "approvedBy": { "type": "string", "minLength": 2 } } },
            "aiGenerated": { "type": "boolean", "description": "import: false only for a licensed image." },
            "receipt": {
              "type": "object",
              "description": "import: provider receipt of the governed run; outputSha256 must equal sha256.",
              "properties": { "provider": { "type": "string" }, "requestId": { "type": "string" }, "outputSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "usdMicros": { "type": ["integer", "null"] }, "estimated": { "type": "boolean" }, "entity": { "type": "string" } }
            },
            "quality": { "enum": ["low", "medium", "high"] },
            "depictsProductUI": { "type": "boolean", "description": "True for a synthetic interface or envisioned future software screen. Allowed in concept/vision/hybrid modes; never substituted as measured proof of existing functionality." },
            "actor": {
              "type": "object", "additionalProperties": false,
              "description": "Optional creative continuity metadata for any fictitious character, including realistic families, patients or clinicians. No blurring or adult-only rule.",
              "properties": {
                "kind": { "enum": ["fictional", "fictional-adult", "reconstruction", "licensed-performer"] },
                "role": { "type": "string" },
                "storyPurpose": { "type": "string" },
                "name": { "type": "string" },
                "ageGroup": { "enum": ["child", "teen", "adult", "older-adult", "unspecified"] },
                "consentReference": { "type": "string", "description": "Optional rights evidence for a named real performer; keep private identifiers outside public repository." },
                "noRealPerson": { "type": "boolean", "description": "Legacy optional metadata" },
                "noPatientOrMinor": { "type": "boolean", "description": "Legacy optional metadata; no longer a creative restriction" }
              }
            }
          }
        },
        "sfx": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["cue", "prompt"],
            "properties": {
              "cue": { "type": "string", "pattern": "^(start|end|at:[0-9.]+|action:.+)$" },
              "prompt": { "type": "string", "minLength": 4 },
              "durationSeconds": { "type": "number", "minimum": 0.5, "maximum": 5 },
              "gainDb": { "type": "number", "minimum": -30, "maximum": 0 }
            }
          }
        }
      }
    }
  }
}
