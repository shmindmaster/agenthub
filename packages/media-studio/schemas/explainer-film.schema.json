{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenthub.local/schemas/media-studio/explainer-film.json",
  "title": "Media Studio explainer film props",
  "description": "The props object the Explainer composition renders. scripts/build-explainer.mjs writes it from the cue sheet, the accepted takes and the explainer plan; scripts/validate-explainer-release.mjs refuses it when the shot grammar or the clock is broken. `visual` is deliberately loose here: its variants are the kit's Visual union and are validated by the picture gates, not duplicated in JSON Schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["film", "shots", "totalSeconds"],
  "properties": {
    "film": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "backdrop", "width", "height", "fps", "chapters"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string" },
        "backdrop": { "type": "string", "enum": ["dots", "stars", "grid", "none"] },
        "width": { "type": "integer", "minimum": 640 },
        "height": { "type": "integer", "minimum": 360 },
        "fps": { "type": "integer", "minimum": 12, "maximum": 60 },
        "accent": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "chrome": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hud": { "type": "boolean" },
            "progress": { "type": "boolean" }
          }
        },
        "chapters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "startSeconds", "endSeconds", "startFrame", "endFrame"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 },
              "startSeconds": { "type": "number", "minimum": 0 },
              "endSeconds": { "type": "number", "exclusiveMinimum": 0 },
              "startFrame": { "type": "integer", "minimum": 0 },
              "endFrame": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "archetype",
          "family",
          "chapterId",
          "startSeconds",
          "durationSeconds",
          "startFrame",
          "durationFrames",
          "beats",
          "holdSeconds"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "archetype": { "type": "string", "minLength": 1 },
          "family": { "type": "string", "minLength": 1 },
          "chapterId": { "type": "string", "minLength": 1 },
          "startSeconds": { "type": "number", "minimum": 0 },
          "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
          "startFrame": { "type": "integer", "minimum": 0 },
          "durationFrames": { "type": "integer", "minimum": 1 },
          "kicker": { "type": "string" },
          "title": { "type": "string" },
          "sub": { "type": "string" },
          "accent": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "chrome": { "type": "string", "enum": ["full", "minimal", "none"] },
          "visual": { "type": "object" },
          "visualScale": { "type": "number", "exclusiveMinimum": 0 },
          "repeatIsPoint": { "type": "boolean" },
          "longShotReason": { "type": "string", "minLength": 8 },
          "heroAtSeconds": { "type": "number", "minimum": 0 },
          "holdSeconds": { "type": "number", "minimum": 0 },
          "beats": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["target", "atSeconds", "frame"],
              "properties": {
                "target": { "type": "string", "minLength": 1 },
                "atSeconds": { "type": "number", "minimum": 0 },
                "frame": { "type": "integer", "minimum": 0 },
                "motion": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "totalSeconds": { "type": "number", "exclusiveMinimum": 0 },
    "voiceoverFile": { "type": "string" }
  }
}
