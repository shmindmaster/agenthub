{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenthub.local/schemas/media-studio/story-experience-review.json",
  "title": "Media studio story-experience review",
  "type": "object",
  "additionalProperties": false,
  "required": ["status"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["COMPLETE", "MALFORMED_INPUT"]
    },
    "candidateId": { "type": "string" },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "pass": {
      "type": "boolean",
      "description": "true only when status is COMPLETE and score is at least 85."
    },
    "missingEvidence": {
      "type": "array",
      "items": { "type": "string" }
    },
    "reason": { "type": "string" },
    "checks": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "enum": ["pass", "fail", "n/a"]
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "location", "evidence", "fix", "owner"],
        "properties": {
          "id": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["block", "major", "minor"]
          },
          "location": { "type": "string" },
          "evidence": { "type": "string" },
          "fix": { "type": "string" },
          "owner": {
            "type": "string",
            "enum": [
              "media-writer",
              "media-storyboard",
              "media-director",
              "media-studio-visuals",
              "media-studio-generate",
              "media-studio-compose"
            ]
          }
        }
      }
    },
    "reviseSceneIds": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
