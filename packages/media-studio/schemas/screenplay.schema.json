{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenthub.local/schemas/media-studio/screenplay.json",
  "title": "Media studio screenplay",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "scenes"],
  "properties": {
    "communicationProfile": {"enum": ["consulting-demo", "technical-walkthrough", "product-update"]},
    "primaryAudience": {"type": "string", "minLength": 1},
    "viewerDecision": {"type": "string", "minLength": 1},
    "primaryTakeaway": {"type": "string", "minLength": 1},
    "audienceContext": {"type": "object", "additionalProperties": false, "required": ["problemStatus", "sourceRefs"], "properties": {"problemStatus": {"enum": ["confirmed-discovery", "hypothesis", "fictional-scenario"]}, "sourceRefs": {"type": "array", "items": {"type": "string", "minLength": 1}}}},
    "nextStep": {"type": "object", "additionalProperties": false, "required": ["action", "owner", "agreedDate"], "properties": {"action": {"type": "string", "minLength": 1}, "owner": {"type": "string", "minLength": 1}, "agreedDate": {"type": ["string", "null"]}, "sourceRefs": {"type": "array", "items": {"type": "string", "minLength": 1}}}},
    "maxDurationSeconds": {"type": "number", "minimum": 1},
    "captionPolicy": {"type": "object", "additionalProperties": false, "required": ["mode", "deliverySurface"], "properties": {"mode": {"enum": ["selectable", "open", "sidecar"]}, "deliverySurface": {"type": "string", "minLength": 1}}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "scenarioRecord": {"type": "string", "minLength": 1},
    "integrationFlow": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "integrationStatus": {"enum": ["demonstrated-adapter", "file-import", "proposed"]},
    "audioDirection": {"type": "object", "additionalProperties": false, "required": ["narratorIdentity", "pronunciationRefs", "delivery", "emphasis", "pauses", "musicTreatment"], "properties": {"narratorIdentity": {"type": "string", "minLength": 1}, "pronunciationRefs": {"type": "array", "items": {"type": "string", "minLength": 1}}, "delivery": {"type": "string", "minLength": 1}, "emphasis": {"type": "array", "items": {"type": "string", "minLength": 1}}, "pauses": {"type": "string", "minLength": 1}, "musicTreatment": {"enum": ["none", "restrained-bed", "compare-bed-and-silence"]}}},
    "product": {"type": "string"},
    "narrative": {"type": "object", "additionalProperties": {"type": "string"}, "description": "A grounded buyer-facing story brief. The lint also requires stage-coded beats and the actual software introduction.", "properties": {"persona": {"type": "string", "minLength": 6}, "situation": {"type": "string", "minLength": 6}, "trigger": {"type": "string", "minLength": 6}, "problem": {"type": "string", "minLength": 6}, "stakes": {"type": "string", "minLength": 6}, "solution": {"type": "string", "minLength": 6}, "mechanism": {"type": "string", "minLength": 6}, "payoff": {"type": "string", "minLength": 6}, "emotionalBefore": {"type": "string", "minLength": 6, "description": "Specific felt cost or uncertainty before the solution, not invented drama."}, "emotionalAfter": {"type": "string", "minLength": 6, "description": "Credible emotional change after the demonstrated outcome."}, "viewerValue": {"type": "string", "minLength": 6, "description": "One useful takeaway or result delivered before the CTA."}}},
    "title": { "type": "string", "minLength": 1 },
    "kind": { "type": "string" },
    "voice": { "type": "string" },
    "hook": {
      "type": "string",
      "description": "Spoken opening that carries payoff or pain in the first 5–8 seconds."
    },
    "emotionalTarget": { "type": "string" },
    "audience": { "type": "string" },
    "viewerPromise": {
      "type": "string",
      "description": "What the viewer can do or stop doing after the film."
    },
    "wpm": {
      "type": "number",
      "minimum": 60,
      "description": "Narration pace used by validate-narration.mjs for the 5-second hook and fluff-seconds estimate. Default 150."
    },
    "narrationAllowlist": {
      "type": "array",
      "description": "Phrases validate-narration.mjs must not flag as fluff, each with the reason it earns its seconds.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["phrase", "reason"],
        "properties": {
          "phrase": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "syntheticDisclosure": { "$ref": "#/$defs/syntheticDisclosure" },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scene" }
    }
  },
  "$defs": {
    "syntheticDisclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "description": "Synthetic or demo data is disclosed on screen, never in narration.",
      "properties": {
        "mode": { "type": "string", "enum": ["caption", "end-card", "none"] },
        "text": { "type": "string" },
        "placement": { "type": "string" }
      }
    },
    "sceneRole": {
      "type": "string",
      "enum": [
        "context", "problem", "solution", "demonstration", "goal", "step", "explanation", "takeaway", "recap", "next-step",
        "hook",
        "before",
        "tension",
        "reveal",
        "proof",
        "trust",
        "hero",
        "payoff",
        "cta",
        "bridge"
      ]
    },
    "visualArchetype": {
      "type": "string",
      "enum": [
        "cold-open",
        "full-bleed-broll",
        "kinetic-statement",
        "kinetic-number",
        "before-after",
        "comparison",
        "diagram-build",
        "timeline",
        "process-flow",
        "screen-in-context",
        "talking-head-sidecar",
        "quote-problem",
        "evidence-proof",
        "checklist-build",
        "hero-reveal",
        "cta-end-frame",
        "chapter-card",
        "lower-third",
        "speaker-slide"
      ]
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "narration"],
      "properties": {
        "actionTitle": {"type": "string", "minLength": 12, "maxLength": 160},
        "supportingArgument": {"type": "string", "minLength": 1},
        "proofRefs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "evidenceClaims": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["text", "scope", "sourceRefs", "implementationState", "dataType", "aiExecutionMode", "businessValidation"], "properties": {"text": {"type": "string", "minLength": 1}, "scope": {"enum": ["product-behavior", "measured-benefit", "proposed-interface", "customer-priority", "illustrative-scenario"]}, "sourceRefs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "implementationState": {"enum": ["implemented", "proposed"]}, "dataType": {"enum": ["synthetic", "customer", "public"]}, "aiExecutionMode": {"enum": ["live", "recorded", "stubbed", "none"]}, "businessValidation": {"enum": ["unvalidated", "measured", "discovery-confirmed"]}, "visibleLabel": {"type": "string", "minLength": 1}, "measurement": {"type": "object", "additionalProperties": false, "required": ["baseline", "comparison", "population", "method", "timeWindow"], "properties": {"baseline": {"type": "string", "minLength": 1}, "comparison": {"type": "string", "minLength": 1}, "population": {"type": "string", "minLength": 1}, "method": {"type": "string", "minLength": 1}, "timeWindow": {"type": "string", "minLength": 1}}}}}},
        "id": { "type": "string", "minLength": 1 },
        "slug": { "type": "string" },
        "sceneRole": { "$ref": "#/$defs/sceneRole" },
        "viewerQuestion": {
          "type": "string",
          "description": "The question this scene answers for the viewer."
        },
        "wiifm": {
          "type": "string",
          "description": "What's in it for the viewer — outcome or identity, not a feature name."
        },
        "narration": { "type": "string", "minLength": 1 },
        "onScreen": { "type": "string" },
        "visualMode": {
          "type": "string",
          "enum": [
            "slide",
            "screen",
            "diagram",
            "talking-head",
            "motif",
            "animation",
            "narration-only",
            "broll"
          ],
          "description": "On product-screencast, default is screen. slide/diagram are title, CTA, or short code/flow cutaways ≤8s (product-picture.md)."
        },
        "visualArchetype": { "$ref": "#/$defs/visualArchetype" },
        "speaker": {
          "type": "string",
          "enum": ["sarosh", "ryan", "Ryan", "vivian", "Vivian", "aiden", "Aiden", "joel"],
          "description": "Host narration (omit/sarosh: the program narrator, voiced by the job voice, never a Sarosh clone in films) or stakeholder Q&A card (ryan/vivian/aiden, each cast to a distinct Azure voice). joel is a legacy Ryan-style interviewer."
        },
        "action": { "type": "string" },
        "uiProof": {
          "type": "object",
          "additionalProperties": false,
          "description": "On product-screencast, the on-screen proof of this spoken claim (product-picture.md).",
          "properties": {
            "actor": {"type": "string"},
            "object": {"type": "string"},
            "significance": {"type": "string"},
            "screen": { "type": "string" },
            "control": { "type": "string" },
            "action": { "type": "string" },
            "systemResponse": { "type": "string" },
            "result": { "type": "string" }
          }
        },
        "highlight": { "type": "string" },
        "durationSeconds": { "type": "number", "minimum": 0.5 },
        "pauseBeforeSeconds": { "type": "number", "minimum": 0 },
        "holdAfterSeconds": { "type": "number", "minimum": 0 },
        "emphasis": {
          "type": "string",
          "description": "One stressed word or short phrase, not a whole sentence."
        },
        "musicCue": {
          "type": "string",
          "enum": ["none", "bed", "sting", "silence"]
        },
        "sfxCue": {
          "type": "string",
          "enum": ["none", "impact-soft", "whoosh", "click", "riser", "accent"]
        },
        "silenceOnReveal": { "type": "boolean" },
        "truth": {
          "type": "string",
          "enum": ["FACT", "DRAMATIZED", "COMPOSITE"]
        },
        "story": { "$ref": "#/$defs/story" },
        "shotPlan": { "$ref": "#/$defs/shotPlan" },
        "rhythm": { "$ref": "#/$defs/rhythm" },
        "sound": { "$ref": "#/$defs/sound" },
        "transition": { "$ref": "#/$defs/transition" },
        "heroMoment": { "type": "boolean" }
      }
    },
    "story": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "beforeState": { "type": "string" },
        "tension": { "type": "string" },
        "openLoop": { "type": "string" },
        "payoff": { "type": "string" },
        "proof": { "type": "string" },
        "trustMoment": { "type": "string" }
      }
    },
    "shotPlan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "framing": {
          "type": "string",
          "enum": ["extreme-wide", "wide", "medium", "close", "insert"]
        },
        "subject": { "type": "string" },
        "movement": {
          "type": "string",
          "enum": ["static", "slow-push", "pull-back", "pan", "cut"]
        },
        "focalPoint": { "type": "string" }
      }
    },
    "rhythm": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "energy": { "type": "number", "minimum": 0, "maximum": 1 },
        "pauseBefore": { "type": "number", "minimum": 0 },
        "holdAfter": { "type": "number", "minimum": 0 },
        "visualRefreshTarget": {
          "type": "number",
          "minimum": 0.5,
          "description": "Seconds until the picture must change again."
        }
      }
    },
    "sound": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "musicCue": {
          "type": "string",
          "enum": ["none", "bed", "sting", "silence"]
        },
        "sfxCue": {
          "type": "string",
          "enum": ["none", "impact-soft", "whoosh", "click", "riser", "accent"]
        },
        "silenceOnReveal": { "type": "boolean" },
        "accentHit": { "type": "boolean" },
        "transitionAudio": {
          "type": "string",
          "enum": ["none", "whoosh", "riser", "silence"]
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["cut", "match-cut", "fade", "hold-then-cut", "whip"]
        },
        "semanticReason": { "type": "string" }
      }
    }
  }
}
