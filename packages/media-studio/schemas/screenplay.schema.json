{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenthub.local/schemas/media-studio/screenplay.json",
  "title": "Media studio screenplay",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "scenes"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "kind": { "type": "string" },
    "voice": { "type": "string" },
    "hook": {
      "type": "string",
      "description": "Spoken opening that carries payoff or pain in the first 5–8 seconds."
    },
    "emotionalTarget": { "type": "string" },
    "audience": { "type": "string" },
    "viewerPromise": {
      "type": "string",
      "description": "What the viewer can do or stop doing after the film."
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scene" }
    }
  },
  "$defs": {
    "sceneRole": {
      "type": "string",
      "enum": [
        "hook",
        "before",
        "tension",
        "reveal",
        "proof",
        "trust",
        "hero",
        "payoff",
        "cta",
        "bridge"
      ]
    },
    "visualArchetype": {
      "type": "string",
      "enum": [
        "cold-open",
        "full-bleed-broll",
        "kinetic-statement",
        "kinetic-number",
        "before-after",
        "comparison",
        "diagram-build",
        "timeline",
        "process-flow",
        "screen-in-context",
        "talking-head-sidecar",
        "quote-problem",
        "evidence-proof",
        "checklist-build",
        "hero-reveal",
        "cta-end-frame",
        "chapter-card",
        "lower-third",
        "speaker-slide"
      ]
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "narration"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "slug": { "type": "string" },
        "sceneRole": { "$ref": "#/$defs/sceneRole" },
        "viewerQuestion": {
          "type": "string",
          "description": "The question this scene answers for the viewer."
        },
        "wiifm": {
          "type": "string",
          "description": "What's in it for the viewer — outcome or identity, not a feature name."
        },
        "narration": { "type": "string", "minLength": 1 },
        "onScreen": { "type": "string" },
        "visualMode": {
          "type": "string",
          "enum": [
            "slide",
            "screen",
            "diagram",
            "talking-head",
            "motif",
            "animation",
            "narration-only",
            "broll"
          ]
        },
        "visualArchetype": { "$ref": "#/$defs/visualArchetype" },
        "speaker": {
          "type": "string",
          "enum": ["sarosh", "ryan", "Ryan", "vivian", "Vivian", "aiden", "Aiden", "joel"],
          "description": "Host narration (omit/sarosh) or stakeholder Q&A card (ryan/vivian/aiden via qwen-role). joel is a legacy Ryan-style interviewer."
        },
        "action": { "type": "string" },
        "highlight": { "type": "string" },
        "durationSeconds": { "type": "number", "minimum": 0.5 },
        "pauseBeforeSeconds": { "type": "number", "minimum": 0 },
        "holdAfterSeconds": { "type": "number", "minimum": 0 },
        "emphasis": {
          "type": "string",
          "description": "One stressed word or short phrase, not a whole sentence."
        },
        "musicCue": {
          "type": "string",
          "enum": ["none", "bed", "sting", "silence"]
        },
        "sfxCue": {
          "type": "string",
          "enum": ["none", "impact-soft", "whoosh", "click", "riser", "accent"]
        },
        "silenceOnReveal": { "type": "boolean" },
        "truth": {
          "type": "string",
          "enum": ["FACT", "DRAMATIZED", "COMPOSITE"]
        },
        "story": { "$ref": "#/$defs/story" },
        "shotPlan": { "$ref": "#/$defs/shotPlan" },
        "rhythm": { "$ref": "#/$defs/rhythm" },
        "sound": { "$ref": "#/$defs/sound" },
        "transition": { "$ref": "#/$defs/transition" },
        "heroMoment": { "type": "boolean" }
      }
    },
    "story": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "beforeState": { "type": "string" },
        "tension": { "type": "string" },
        "openLoop": { "type": "string" },
        "payoff": { "type": "string" },
        "proof": { "type": "string" },
        "trustMoment": { "type": "string" }
      }
    },
    "shotPlan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "framing": {
          "type": "string",
          "enum": ["extreme-wide", "wide", "medium", "close", "insert"]
        },
        "subject": { "type": "string" },
        "movement": {
          "type": "string",
          "enum": ["static", "slow-push", "pull-back", "pan", "cut"]
        },
        "focalPoint": { "type": "string" }
      }
    },
    "rhythm": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "energy": { "type": "number", "minimum": 0, "maximum": 1 },
        "pauseBefore": { "type": "number", "minimum": 0 },
        "holdAfter": { "type": "number", "minimum": 0 },
        "visualRefreshTarget": {
          "type": "number",
          "minimum": 0.5,
          "description": "Seconds until the picture must change again."
        }
      }
    },
    "sound": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "musicCue": {
          "type": "string",
          "enum": ["none", "bed", "sting", "silence"]
        },
        "sfxCue": {
          "type": "string",
          "enum": ["none", "impact-soft", "whoosh", "click", "riser", "accent"]
        },
        "silenceOnReveal": { "type": "boolean" },
        "accentHit": { "type": "boolean" },
        "transitionAudio": {
          "type": "string",
          "enum": ["none", "whoosh", "riser", "silence"]
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["cut", "match-cut", "fade", "hold-then-cut", "whip"]
        },
        "semanticReason": { "type": "string" }
      }
    }
  }
}
