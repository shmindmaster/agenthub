{
  "schemaVersion": "1.0.0",
  "capabilityId": "media-studio",
  "capabilityVersion": "4.6.0",
  "canonicalOwner": "personal-media",
  "toolRouting": {
    "productReadiness": "product:demo",
    "browserDiagnostics": "browser-toolkit",
    "masterCapture": "@playwright/cli@0.1.17",
    "repeatableCapture": "@playwright/test@1.62.1",
    "composition": "external-finishing-adapter",
    "pointerFinishing": "playwright-recast@0.21.0",
    "experimentalComposition": "playwright-recast@0.21.0",
    "exceptionalComposition": "remotion:remotion-best-practices",
    "ownerVoiceProvider": "deepgram-flux",
    "ownerVoiceRoute": "Run skills/produce/references/narration-preflight.md, then select the voice from skills/produce/references/voice-recipes.md. Stock voices: Deepgram Flux Sienna or Haley for every film except ABACare, then Azure DragonHD (Emma2 or Andrew2, Ava as fallback); ABACare films use the AssemblyAI clones of Syeda F. Abidi (her own recorded consent) or Sarosh, never a stock substitute. Other films use a clone, AssemblyAI or ElevenLabs only when the owner asks for it by name in that job. Desktop speech and HeyGen stock avatar voices are forbidden",
    "ownerVoiceAdvisoryScore": null,
    "audioPerceptionRoute": "Azure STT ASR check (fast transcription, or kit/cloud/cloud-ai.mjs align coverage) of the exact encoded candidate against the authored script",
    "elevenLabsProvider": "elevenlabs",
    "editorialFinish": "compose",
    "github": "gh-cli",
    "requirements": [
      "notion:notion",
      "linear:linear"
    ]
  },
  "captureQualityPolicy": {
    "guidedScreencastRequired": true,
    "pageOnlyOrNativeFullscreenPreferred": true,
    "extraneousBrowserOrOsChromeAllowedOnlyAsEvidence": true,
    "minimumPlannedActiveRegionCoverage": 0.5,
    "minimumCaptureDeviceScaleFactor": 2,
    "minimumEffectiveDeliveryPixelDensity": 1,
    "pointerMoveMilliseconds": {
      "minimum": 400,
      "maximum": 600
    },
    "clickSettleMilliseconds": 250,
    "clickHoldMilliseconds": 500,
    "clickPulseMilliseconds": {
      "minimum": 300,
      "maximum": 400
    },
    "clickPulseBrandColorRequired": true,
    "clickPulseSemiTransparent": true,
    "smallDeliveryCursorScale": {
      "minimum": 1.5,
      "maximum": 2
    },
    "zoomTransitionMilliseconds": {
      "minimum": 300,
      "maximum": 500
    },
    "maximumZoomChangesPerBeat": 1,
    "uiCameraDriftAllowed": false,
    "boundedWaitSpeedMultiplier": {
      "minimum": 4,
      "maximum": 8
    },
    "textEntrySpeedMultiplier": {
      "minimum": 3,
      "maximum": 4
    },
    "annotationWordsPerSecond": 2.5,
    "annotationReadingBufferSeconds": 0.5,
    "truthfulLatencyTreatmentRequired": true,
    "realProductActionAndStateTransitionRequired": true,
    "visibleClickCueRequired": true,
    "resultVisibleBeforeSpokenResult": true,
    "blockedTransientSurfaces": [
      "unexpected-toast",
      "feedback-widget",
      "cookie-or-consent-banner",
      "tooltip-or-popover",
      "debug-or-demo-label",
      "personal-browser-artifact",
      "clipped-overlay",
      "unrelated-notification"
    ],
    "phaseCompleteFrameEvidenceRequired": true,
    "requiredFramePhases": [
      "cold-open",
      "hook",
      "transition",
      "hero-before",
      "hero-action",
      "hero-result",
      "trust-boundary",
      "cta",
      "end-card-entry",
      "stable-final-hold"
    ],
    "minimumStableFinalHoldSeconds": 3
  }
}
