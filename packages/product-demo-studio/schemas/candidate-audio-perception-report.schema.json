{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenthub.local/schemas/product-video/candidate-audio-perception-report.schema.json",
  "title": "Product Video Candidate Audio Perception Report",
  "description": "Immutable Product Demo Studio envelope around distinct native ai.ps1 listen reports for the exact candidate and independent calibration inputs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reportId", "candidate", "listener", "calibration", "status", "generatedAt"],
  "properties": {
    "schemaVersion": { "const": "1.1.0" },
    "reportId": { "type": "string", "pattern": "^PVAR-[A-Z0-9][A-Z0-9-]*-[0-9]{3,}$" },
    "candidate": { "$ref": "#/$defs/candidateReference" },
    "listener": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "controlPlane", "command", "localOnly", "report", "modelReceipt"],
      "properties": {
        "kind": { "const": "local-audio-model" },
        "controlPlane": { "const": "ai.ps1" },
        "command": { "const": "listen" },
        "localOnly": { "const": true },
        "report": { "$ref": "#/$defs/artifactReference" },
        "modelReceipt": { "$ref": "#/$defs/artifactReference" }
      }
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["calibrationId", "promptVersion", "promptSha256", "model", "evaluatedAt", "validUntil", "knownGood", "knownBad"],
      "properties": {
        "calibrationId": { "type": "string", "pattern": "^PVAC-[A-Z0-9][A-Z0-9-]*-[0-9]{3,}$" },
        "promptVersion": { "$ref": "#/$defs/nonEmptyString" },
        "promptSha256": { "$ref": "#/$defs/sha256" },
        "model": { "$ref": "#/$defs/modelIdentity" },
        "evaluatedAt": { "type": "string", "format": "date-time" },
        "validUntil": { "type": "string", "format": "date-time" },
        "knownGood": {
          "allOf": [
            { "$ref": "#/$defs/calibrationCase" },
            { "properties": { "expectedStatus": { "const": "PASS" }, "observedStatus": { "const": "PASS" } } }
          ]
        },
        "knownBad": {
          "allOf": [
            { "$ref": "#/$defs/calibrationCase" },
            { "properties": { "expectedStatus": { "const": "FAIL" }, "observedStatus": { "const": "FAIL" } } }
          ]
        }
      }
    },
    "status": { "enum": ["PASS", "FAIL"] },
    "generatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "safeId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "bytes": { "type": "integer", "minimum": 1 },
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactPath", "sha256", "bytes"],
      "properties": {
        "artifactPath": { "$ref": "#/$defs/nonEmptyString" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "$ref": "#/$defs/bytes" }
      }
    },
    "candidateReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateId", "artifactPath", "sha256", "bytes", "sourceRevision", "renderProvenanceId"],
      "properties": {
        "candidateId": { "$ref": "#/$defs/safeId" },
        "artifactPath": { "$ref": "#/$defs/nonEmptyString" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "$ref": "#/$defs/bytes" },
        "sourceRevision": { "$ref": "#/$defs/nonEmptyString" },
        "renderProvenanceId": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "modelIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "receiptSha256"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "revision": { "$ref": "#/$defs/nonEmptyString" },
        "receiptSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "calibrationCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseId", "audio", "nativeReport", "rawResponse", "expectedStatus", "observedStatus"],
      "properties": {
        "caseId": { "$ref": "#/$defs/safeId" },
        "audio": { "$ref": "#/$defs/artifactReference" },
        "nativeReport": { "$ref": "#/$defs/artifactReference" },
        "rawResponse": { "$ref": "#/$defs/artifactReference" },
        "expectedStatus": { "enum": ["PASS", "FAIL"] },
        "observedStatus": { "enum": ["PASS", "FAIL"] }
      }
    }
  }
}
