{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenthub.local/schemas/product-video/remediation-assignment.schema.json",
  "title": "Product Video Remediation Assignment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "assignmentId",
    "candidateId",
    "domain",
    "assignedFindingIds",
    "permittedFiles",
    "prohibitedFiles",
    "evidence",
    "reproductionSteps",
    "validationCommands",
    "definitionOfDone",
    "permissions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "assignmentId": {
      "type": "string",
      "pattern": "^PVA-[A-Z0-9][A-Z0-9-]*-[0-9]{3,}$"
    },
    "candidateId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "domain": {
      "enum": [
        "story-script",
        "product-seed-data",
        "capture-playwright",
        "remotion-composition",
        "narration-audio",
        "captions",
        "export-pipeline",
        "infrastructure-assets"
      ]
    },
    "assignedFindingIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^PVF-[A-Z0-9][A-Z0-9-]*-[0-9]{3,}$"
      }
    },
    "permittedFiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/repositoryRelativePath"
      }
    },
    "prohibitedFiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/repositoryRelativePath"
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidenceReference"
      }
    },
    "reproductionSteps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "validationCommands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "expectedResult"
        ],
        "properties": {
          "command": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "expectedResult": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "definitionOfDone": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "writeScope",
        "mayApproveRelease",
        "destructiveGitAllowed",
        "forcePushAllowed",
        "broadWorkspaceWritesAllowed",
        "mayDeleteSourceEvidence"
      ],
      "properties": {
        "writeScope": {
          "const": "assigned-files-only"
        },
        "mayApproveRelease": {
          "const": false
        },
        "destructiveGitAllowed": {
          "const": false
        },
        "forcePushAllowed": {
          "const": false
        },
        "broadWorkspaceWritesAllowed": {
          "const": false
        },
        "mayDeleteSourceEvidence": {
          "const": false
        }
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "repositoryRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:[\\\\/])(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).*\\S.*$"
    },
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "artifactPath",
        "sha256",
        "description"
      ],
      "properties": {
        "artifactId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "artifactPath": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    }
  }
}
