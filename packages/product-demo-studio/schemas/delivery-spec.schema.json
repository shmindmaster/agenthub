{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenthub.local/schemas/product-video/delivery-spec.schema.json",
  "title": "Product Video Delivery Specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "platform",
    "container",
    "video",
    "audio",
    "fastStartRequired",
    "maxConsecutiveDuplicateFrames"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "platform": {
      "type": "string",
      "minLength": 1
    },
    "container": {
      "type": "string",
      "minLength": 1
    },
    "video": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "codec",
        "width",
        "height",
        "frameRate",
        "pixelFormat",
        "colorSpace",
        "colorTransfer",
        "colorPrimaries"
      ],
      "properties": {
        "codec": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "frameRate": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "frameRateTolerance": {
          "type": "number",
          "minimum": 0
        },
        "pixelFormat": {
          "type": "string",
          "minLength": 1
        },
        "colorSpace": {
          "type": "string",
          "minLength": 1
        },
        "colorTransfer": {
          "type": "string",
          "minLength": 1
        },
        "colorPrimaries": {
          "type": "string",
          "minLength": 1
        },
        "minimumDurationSeconds": {
          "type": "number",
          "minimum": 0
        },
        "maximumDurationSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "codec": {
          "type": "string",
          "minLength": 1
        },
        "sampleRate": {
          "type": "integer",
          "minimum": 1
        },
        "channels": {
          "type": "integer",
          "minimum": 1
        },
        "targetIntegratedLUFS": {
          "type": "number"
        },
        "loudnessToleranceLU": {
          "type": "number",
          "minimum": 0
        },
        "maximumTruePeakDb": {
          "type": "number",
          "maximum": 0
        }
      }
    },
    "fastStartRequired": {
      "type": "boolean"
    },
    "maxConsecutiveDuplicateFrames": {
      "type": "integer",
      "minimum": 1
    }
  }
}
