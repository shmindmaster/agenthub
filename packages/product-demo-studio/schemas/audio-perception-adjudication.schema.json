{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenthub.local/schemas/product-video/audio-perception-adjudication.schema.json",
  "title": "Product Video Audio Perception Adjudication",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "adjudicationId",
    "candidate",
    "perceptionReport",
    "reviewer",
    "checks",
    "findings",
    "status",
    "generatedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "adjudicationId": { "type": "string", "pattern": "^PVAA-[A-Z0-9][A-Z0-9-]*-[0-9]{3,}$" },
    "candidate": { "$ref": "#/$defs/candidateReference" },
    "perceptionReport": { "$ref": "#/$defs/artifactReference" },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "contextId", "readOnly", "independent", "executionReceipt"],
      "properties": {
        "role": { "const": "audio-captions-sync-reviewer" },
        "contextId": { "$ref": "#/$defs/nonEmptyString" },
        "readOnly": { "const": true },
        "independent": { "const": true },
        "executionReceipt": { "$ref": "#/$defs/executionReceiptReference" }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/adjudicationCheck" },
      "allOf": [
        { "contains": { "properties": { "id": { "const": "candidate-binding" } }, "required": ["id"] } },
        { "contains": { "properties": { "id": { "const": "decoded-sample-coverage" } }, "required": ["id"] } },
        { "contains": { "properties": { "id": { "const": "model-provenance" } }, "required": ["id"] } },
        { "contains": { "properties": { "id": { "const": "prompt-and-raw-response" } }, "required": ["id"] } },
        { "contains": { "properties": { "id": { "const": "calibration" } }, "required": ["id"] } },
        { "contains": { "properties": { "id": { "const": "audio-criteria" } }, "required": ["id"] } }
      ]
    },
    "findings": {
      "type": "array",
      "items": { "type": "string", "pattern": "^PVF-[A-Z0-9][A-Z0-9-]*-[0-9]{3,}$" }
    },
    "status": { "enum": ["PASS", "FAIL"] },
    "generatedAt": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "PASS" } }, "required": ["status"] },
      "then": {
        "properties": {
          "findings": { "maxItems": 0 },
          "checks": { "items": { "properties": { "passed": { "const": true } } } }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "FAIL" } }, "required": ["status"] },
      "then": {
        "properties": {
          "findings": { "minItems": 1 },
          "checks": {
            "contains": { "properties": { "passed": { "const": false } }, "required": ["passed"] }
          }
        }
      }
    }
  ],
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "safeId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "bytes": { "type": "integer", "minimum": 1 },
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactPath", "sha256", "bytes"],
      "properties": {
        "artifactPath": { "$ref": "#/$defs/nonEmptyString" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "$ref": "#/$defs/bytes" }
      }
    },
    "candidateReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateId", "artifactPath", "sha256", "bytes", "sourceRevision", "renderProvenanceId"],
      "properties": {
        "candidateId": { "$ref": "#/$defs/safeId" },
        "artifactPath": { "$ref": "#/$defs/nonEmptyString" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "$ref": "#/$defs/bytes" },
        "sourceRevision": { "$ref": "#/$defs/nonEmptyString" },
        "renderProvenanceId": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "executionReceiptReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt"],
      "properties": {
        "receipt": { "$ref": "#/$defs/artifactReference" }
      }
    },
    "adjudicationCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "passed", "notes"],
      "properties": {
        "id": {
          "enum": [
            "candidate-binding",
            "decoded-sample-coverage",
            "model-provenance",
            "prompt-and-raw-response",
            "calibration",
            "audio-criteria"
          ]
        },
        "passed": { "type": "boolean" },
        "notes": { "$ref": "#/$defs/nonEmptyString" }
      }
    }
  }
}
