{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenthub.local/schemas/product-video/editorial-audit.schema.json",
  "title": "Product Video Orchestrator Editorial Audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "auditId",
    "candidate",
    "auditor",
    "fullPlayback",
    "phaseChecks",
    "findings",
    "status",
    "generatedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "auditId": { "type": "string", "pattern": "^PVEA-[A-Z0-9][A-Z0-9-]*-[0-9]{3,}$" },
    "candidate": { "$ref": "#/$defs/candidateReference" },
    "auditor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "contextId"],
      "properties": {
        "role": { "const": "orchestrator" },
        "contextId": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "fullPlayback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["continuous", "mediaDurationSeconds", "startedAt", "completedAt"],
      "properties": {
        "continuous": { "const": true },
        "mediaDurationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "startedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" }
      }
    },
    "phaseChecks": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": { "$ref": "#/$defs/phaseCheck" },
      "allOf": [
        { "contains": { "properties": { "phase": { "const": "opening-promise" } }, "required": ["phase"] } },
        { "contains": { "properties": { "phase": { "const": "transitions-and-focus" } }, "required": ["phase"] } },
        { "contains": { "properties": { "phase": { "const": "hero-before-action-result" } }, "required": ["phase"] } },
        { "contains": { "properties": { "phase": { "const": "screen-cleanliness" } }, "required": ["phase"] } },
        { "contains": { "properties": { "phase": { "const": "responsive-legibility" } }, "required": ["phase"] } },
        { "contains": { "properties": { "phase": { "const": "cta-and-impact" } }, "required": ["phase"] } },
        { "contains": { "properties": { "phase": { "const": "stable-final-hold" } }, "required": ["phase"] } }
      ]
    },
    "findings": {
      "type": "array",
      "items": { "type": "string", "pattern": "^PVF-[A-Z0-9][A-Z0-9-]*-[0-9]{3,}$" }
    },
    "status": { "enum": ["PASS", "FAIL"] },
    "generatedAt": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "PASS" } }, "required": ["status"] },
      "then": {
        "properties": {
          "findings": { "maxItems": 0 },
          "phaseChecks": {
            "items": { "properties": { "passed": { "const": true } } }
          }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "FAIL" } }, "required": ["status"] },
      "then": { "properties": { "findings": { "minItems": 1 } } }
    }
  ],
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "safeId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "candidateReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateId", "artifactPath", "sha256", "bytes", "sourceRevision", "renderProvenanceId"],
      "properties": {
        "candidateId": { "$ref": "#/$defs/safeId" },
        "artifactPath": { "$ref": "#/$defs/nonEmptyString" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 1 },
        "sourceRevision": { "$ref": "#/$defs/nonEmptyString" },
        "renderProvenanceId": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "phaseCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "passed", "evidence"],
      "properties": {
        "phase": {
          "enum": [
            "opening-promise",
            "transitions-and-focus",
            "hero-before-action-result",
            "screen-cleanliness",
            "responsive-legibility",
            "cta-and-impact",
            "stable-final-hold"
          ]
        },
        "passed": { "type": "boolean" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/phaseEvidence" }
        }
      }
    },
    "phaseEvidence": {
      "oneOf": [
        { "$ref": "#/$defs/artifactPhaseEvidence" },
        { "$ref": "#/$defs/frameTimestampEvidence" }
      ]
    },
    "artifactPhaseEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "artifactPath", "sha256", "bytes", "candidateSha256", "timestampSeconds"],
      "properties": {
        "kind": { "const": "artifact" },
        "artifactPath": { "$ref": "#/$defs/nonEmptyString" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 1 },
        "candidateSha256": { "$ref": "#/$defs/sha256" },
        "timestampSeconds": { "type": "number", "minimum": 0 }
      }
    },
    "frameTimestampEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "candidateSha256", "timestampSeconds", "frameSha256"],
      "properties": {
        "kind": { "const": "frame-timestamp" },
        "candidateSha256": { "$ref": "#/$defs/sha256" },
        "timestampSeconds": { "type": "number", "minimum": 0 },
        "frameSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
