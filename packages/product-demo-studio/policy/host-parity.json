{
  "schemaVersion": "1.0.0",
  "capabilityId": "product-demo-studio",
  "capabilityVersion": "1.8.6",
  "hostInventorySource": "registry/capabilities.json#product-demo-studio.hostMappings",
  "equivalentContract": {
    "canonicalPolicy": "policy/product-video-policy.json",
    "findingSchema": "schemas/video-finding.schema.json",
    "reviewSchema": "schemas/review-report.schema.json",
    "reviewerCalibrationSchema": "schemas/reviewer-calibration.schema.json",
    "calibrationReviewResultSchema": "schemas/calibration-review-result.schema.json",
    "mediaAccelerationSchema": "schemas/media-acceleration.schema.json",
    "editorialAuditSchema": "schemas/editorial-audit.schema.json",
    "audioPerceptionReportSchema": "schemas/candidate-audio-perception-report.schema.json",
    "localAiListenReportSchema": "schemas/local-ai-listen-report.schema.json",
    "audioPerceptionAdjudicationSchema": "schemas/audio-perception-adjudication.schema.json",
    "decisionSchema": "schemas/release-decision.schema.json",
    "finalVerificationSchema": "schemas/final-verification.schema.json",
    "executionReceiptSchema": "schemas/execution-receipt.schema.json",
    "releaseEvidenceSchema": "schemas/release-evidence.schema.json",
    "reviewDeliverySchema": "schemas/review-delivery.schema.json",
    "interactiveDeepDiveSchema": "schemas/interactive-deep-dive.schema.json",
    "unsupportedIsolationDecision": "PIPELINE_BLOCKED"
  },
  "conditionallyEligibleReviewHosts": [
    "antigravity",
    "claude",
    "codex",
    "cursor",
    "gemini",
    "grok",
    "opencode",
    "qoder",
    "qwen-code"
  ],
  "mappedHosts": [
    "amp",
    "antigravity",
    "claude",
    "cline",
    "codex",
    "copilot",
    "cursor",
    "devin",
    "factory",
    "gemini",
    "grok",
    "hermes",
    "opencode",
    "qoder",
    "qwen-code",
    "vscode-insiders",
    "warp",
    "windsurf"
  ],
  "executionRule": {
    "capabilityExposureIsReleaseEligibility": false,
    "liveRunMustRecordNativeReadOnlyEnforcement": true,
    "liveRunMustProvideReadOnlyExecutionReceipt": true,
    "shellFreeReadOnlyReviewerAllowed": true,
    "hostPostValidatorRequired": true,
    "agentAuthoredExecutionReceiptAllowed": true,
    "promptOnlyOrBroadWriteContextMayRelease": false,
    "missingOrFailedEnforcementDecision": "PIPELINE_BLOCKED",
    "cursorDispatchAllowed": true
  },
  "validationScope": {
    "defaultMode": "STATIC_INVENTORY_ONLY",
    "staticValidationMayClaimLiveParity": false,
    "liveParityRequiresDeploymentReport": true,
    "staticValidationProves": [
      "registry mapping inventory",
      "canonical contract file availability",
      "fail-closed policy shape"
    ],
    "staticValidationDoesNotProve": [
      "deployed package bytes",
      "host-native read-only enforcement",
      "runtime smoke-test behavior",
      "cross-host functional parity"
    ]
  },
  "liveDeploymentReportContract": {
    "schemaVersion": "1.0.0",
    "coverage": "exactly-one-row-per-mapped-host",
    "canonicalContractHashAlgorithm": "sha256(relative-path-null-bytes-null)",
    "requiredEvidence": [
      "deploymentEvidence",
      "nativeReadOnlyEnforcement.evidence",
      "smokeTest.evidence"
    ],
    "cursorDispatchMustRemainSuppressed": false
  }
}
