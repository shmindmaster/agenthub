{
  "schemaVersion": "1.0.0",
  "capabilityId": "product-demo-studio",
  "capabilityVersion": "1.7.9",
  "canonicalOwner": "handoff",
  "toolRouting": {
    "productReadiness": "product-experience-engineering:prepare-product-for-demo",
    "browserDiagnostics": "browser-toolkit",
    "masterCapture": "@playwright/cli@0.1.17",
    "repeatableCapture": "@playwright/test@1.62.1",
    "composition": "external-finishing-adapter",
    "experimentalComposition": "playwright-recast@0.19.2-windows-spike-blocked",
    "exceptionalComposition": "remotion:remotion-best-practices",
    "ownerVoiceProvider": "local-ai",
    "ownerVoiceRoute": "ai.ps1 voice qwen-clone --voice sarosh",
    "ownerVoiceGate": "media/qa/score_identity.py",
    "elevenLabsProvider": "elevenlabs",
    "editorialFinish": "product-demo-studio-descript",
    "github": "gh-cli",
    "requirements": [
      "notion:notion",
      "linear:linear"
    ]
  },
  "ownerVoiceProductionPolicy": {
    "canonicalTextMutationAllowed": false,
    "phoneticRespellingAllowed": false,
    "pronunciationRiskManifestRequired": true,
    "riskClasses": [
      "heteronym",
      "irregular-spelling",
      "stress-shift",
      "proper-noun",
      "loanword",
      "acronym-or-initialism",
      "symbol",
      "domain-term"
    ],
    "heteronymContextRequired": true,
    "meaningPartOfSpeechAndIpaRequired": true,
    "asrAloneMayApprovePronunciation": false,
    "properNounHomophoneStressAndAccentListeningRequired": true,
    "referenceAudio": {
      "fullIclRequired": true,
      "exactTranscriptRequired": true,
      "matchingLanguageRequired": true,
      "minimumSampleRateHz": 24000,
      "minimumBitsPerSample": 16,
      "monoRequired": true,
      "minimumSpeechDensity": 0.6,
      "maximumUnexplainedPauseSeconds": 2,
      "preferredDurationSeconds": { "minimum": 10, "maximum": 15 },
      "shorterMeasuredReferenceAllowed": true,
      "hashesRequired": true
    },
    "segmentation": {
      "semanticSentenceBreathOrSceneChunksRequired": true,
      "arbitraryCharacterBlocksAllowed": false,
      "stableSegmentIdsRequired": true,
      "attemptsImmutable": true,
      "timeStretchAllowed": false
    },
    "postProcessing": {
      "individualDynamicCompressionAllowed": false,
      "blindFixedTailTrimAllowed": false,
      "tailArtifactDetectionRequired": true,
      "finalProgramTransparentTruePeakLimiterAllowed": true
    },
    "acceptance": {
      "listeningRequired": true,
      "listeningPerformer": "orchestrator-or-audio-reviewer",
      "fullContinuousEncodedCandidateRequired": true,
      "listeningReceiptSchema": "schemas/candidate-listening-receipt.schema.json",
      "exactCandidatePathHashAndBytesRequired": true,
      "ffprobeDurationMatchRequired": true,
      "listeningIntervalAtLeastMediaDurationRequired": true,
      "ownerApprovalRequired": false,
      "asrContentCheckRequired": true,
      "dualSpeakerIdentityGateRequired": true,
      "captionSynchronizationRequired": true,
      "loudnessAndTruePeakGateRequired": true
    }
  },
  "candidateListeningPolicy": {
    "requiredForArbitrationDecisions": ["PASS", "REMEDIATE"],
    "receiptSchema": "schemas/candidate-listening-receipt.schema.json",
    "allowedListenerRoles": ["orchestrator", "audio-captions-sync-reviewer"],
    "fullContinuousEncodedCandidateRequired": true,
    "exactCandidatePathHashAndBytesRequired": true,
    "sourceRevisionAndRenderProvenanceRequired": true,
    "ffprobeDurationMatchRequired": true,
    "listeningIntervalAtLeastMediaDurationRequired": true,
    "passReceiptRequiredForPassDecision": true,
    "failedReceiptMayRouteToRemediate": true,
    "ownerApprovalRequired": false
  },
  "connectorPolicy": {
    "readBeforeWrite": true,
    "exactIdentifiersRequired": true,
    "recordReturnedArtifacts": true,
    "descriptOptional": true,
    "duplicateDescriptConnectionAllowed": false,
    "descriptEditCreatesNewCandidate": true,
    "descriptPublishRequiresExplicitAuthorization": true,
    "unchecksumableDescriptOutputDecision": "PIPELINE_BLOCKED",
    "credentialsInAdaptersAllowed": false
  },
  "reviewDeliveryPolicy": {
    "agentHubRegistry": "registry/product-video-delivery.json",
    "classification": "review-only",
    "requiresArbiterPass": true,
    "requiresFinalVerifierPass": true,
    "immutableCandidateDirectory": true,
    "overwriteAllowed": false,
    "firstHumanTouchpoint": "final-presentation",
    "automatedAcceptanceRequired": true
  },
  "workspacePolicy": {
    "agentHubRegistry": "registry/product-video-delivery.json",
    "targetRepositoriesReadOnlyByDefault": true,
    "generatedRepositoryFoldersAllowed": false,
    "acceptedOutputsUseMappedOneDriveRoot": true
  },
  "captureQualityPolicy": {
    "guidedScreencastRequired": true,
    "pageOnlyOrNativeFullscreenPreferred": true,
    "extraneousBrowserOrOsChromeAllowedOnlyAsEvidence": true,
    "minimumPlannedActiveRegionCoverage": 0.5,
    "minimumCaptureDeviceScaleFactor": 2,
    "minimumEffectiveDeliveryPixelDensity": 1,
    "pointerMoveMilliseconds": { "minimum": 400, "maximum": 600 },
    "clickSettleMilliseconds": 250,
    "clickHoldMilliseconds": 500,
    "clickPulseMilliseconds": { "minimum": 300, "maximum": 400 },
    "clickPulseBrandColorRequired": true,
    "clickPulseSemiTransparent": true,
    "smallDeliveryCursorScale": { "minimum": 1.5, "maximum": 2 },
    "zoomTransitionMilliseconds": { "minimum": 300, "maximum": 500 },
    "maximumZoomChangesPerBeat": 1,
    "uiCameraDriftAllowed": false,
    "boundedWaitSpeedMultiplier": { "minimum": 4, "maximum": 8 },
    "textEntrySpeedMultiplier": { "minimum": 3, "maximum": 4 },
    "annotationWordsPerSecond": 2.5,
    "annotationReadingBufferSeconds": 0.5,
    "truthfulLatencyTreatmentRequired": true,
    "realProductActionAndStateTransitionRequired": true,
    "visibleClickCueRequired": true,
    "resultVisibleBeforeSpokenResult": true,
    "blockedTransientSurfaces": [
      "unexpected-toast",
      "feedback-widget",
      "cookie-or-consent-banner",
      "tooltip-or-popover",
      "debug-or-demo-label",
      "personal-browser-artifact",
      "clipped-overlay",
      "unrelated-notification"
    ],
    "phaseCompleteFrameEvidenceRequired": true,
    "requiredFramePhases": [
      "cold-open",
      "hook",
      "transition",
      "hero-before",
      "hero-action",
      "hero-result",
      "trust-boundary",
      "cta",
      "end-card-entry",
      "stable-final-hold"
    ],
    "minimumStableFinalHoldSeconds": 3
  },
  "youtubeReleaseQualityPolicy": {
    "viewerPromiseBindingRequired": true,
    "titleThumbnailOpeningOutcomeMustAgree": true,
    "titleAccurateSuccinctAndImportantWordsFirst": true,
    "customThumbnailRequired": true,
    "thumbnailSmallDisplayReviewRequired": true,
    "firstThirtySecondPromiseFulfillmentRequired": true,
    "appealEngagementAndSatisfactionReviewRequired": true,
    "valueDensityRequired": true,
    "universalDurationTargetAllowed": false,
    "tagVolumeScored": false,
    "singlePrimaryCtaRequired": true,
    "metadataClaimsMustUseClaimLedger": true,
    "syntheticDataAndAiVoiceDisclosuresRequired": true,
    "postPublicationSignals": [
      "impressions-click-through-rate",
      "first-thirty-second-retention",
      "average-percentage-viewed",
      "retention-dips-and-spikes",
      "end-screen-click-rate"
    ],
    "insufficientAnalyticsDecision": "INSUFFICIENT_DATA"
  },
  "orchestratorEditorialAuditPolicy": {
    "requiredBeforeExternalPublication": true,
    "fullStartToFinishPlaybackRequired": true,
    "actualOpeningTransitionHeroCtaAndFinalFramesRequired": true,
    "screenCleanlinessAndProductExperienceRequired": true,
    "mayBlockOrRemediate": true,
    "mayReplaceIndependentReviews": false,
    "mayApproveWithoutFinalVerifier": false,
    "ownerWatchOrListenApprovalRequired": false,
    "candidateByteChangeInvalidatesAudit": true,
    "phaseEvidenceRequired": true,
    "phaseEvidenceCandidateHashRequired": true,
    "artifactEvidenceChecksumAndByteCountRequired": true,
    "frameTimestampEvidenceDecodedFromCandidateRequired": true
  },
  "hardwareAccelerationPolicy": {
    "capabilityDetectionRequired": true,
    "compatibleGpuPreferred": true,
    "preferredDomains": [
      "video-encoding",
      "asr",
      "ocr",
      "local-media-inference",
      "gpu-composition-effects"
    ],
    "agentReasoningRequiresLocalGpu": false,
    "cpuFallbackAllowed": true,
    "cpuFallbackReasonRequired": true,
    "outputEquivalenceValidationRequired": true,
    "accelerationManifestRequiredInRenderProvenance": true
  },
  "reviewIndependencePolicy": {
    "generatorMayReviewOwnOutput": false,
    "generatorReasoningPassedToReviewer": false,
    "reviewerLoadsCanonicalRubricDirectly": true,
    "rubricAndOverlayContentHashesRequired": true,
    "evidenceRequiredForPassAndFail": true,
    "unevidencedCriterionDecision": "PIPELINE_BLOCKED",
    "reviewerMayEditCandidateOrSource": false
  },
  "autonomyPolicy": {
    "humanInteractionBeforeFinalPresentationAllowed": false,
    "acceptanceIsAutomated": true,
    "continuousEvaluationAndRemediationRequired": true,
    "terminalHumanTouchpoint": "final-presentation"
  },
  "remediationCyclePolicy": {
    "fixedAttemptLimit": false,
    "continueUntilPassOrEvidenceBackedBlocker": true,
    "stopOnNoMaterialProgressAllowed": false
  },
  "verticalRubricOverlayPolicy": {
    "baseRubricImmutablePerCandidate": true,
    "overlayContentHashRequired": true,
    "mayAddCriteria": true,
    "mayTightenSeverityOrThresholds": true,
    "mayRemoveBaseCriteria": false,
    "mayWeakenBaseThresholds": false
  },
  "calibrationPolicy": {
    "fixtureCatalog": "skills/product-demo-studio/references/reviewer-calibration.md",
    "knownBadAndCleanPassRequired": true,
    "requiredAfterRubricAgentModelOrInputContractChange": true,
    "maximumAgeDays": 7,
    "missingOrFailedCalibrationDecision": "PIPELINE_BLOCKED",
    "passedKnownBadInvalidatesVerdictsSinceLastSuccess": true
  },
  "seededRuntimePolicy": {
    "liveSeededEnvironmentRequiredForWorthinessAssessment": true,
    "resetOrReseedEvidenceRequired": true,
    "repositoryInspectionAloneIsSufficient": false
  },
  "narrationTimingPolicy": {
    "validatedNarrationGeneratedBeforeFinalCapture": true,
    "providerLatencyExcludedFromRecordedTimeline": true,
    "wordTimestampsRequired": true,
    "singleSourceToOutputTimingMapRequired": true,
    "shortestStreamTruncationAllowed": false,
    "offlineTimingProxyMayShip": false
  },
  "permissions": {
    "executionEnforcement": {
      "instructionOnlyIsolationIsSufficient": false,
      "reviewerArbiterFinalVerifierRequireHostEnforcedReadOnlyIsolation": true,
      "unsupportedHostDecision": "PIPELINE_BLOCKED",
      "hostNativeReadOnlyRoleRequired": true,
      "executionReceiptsRecordDeclaredContext": true,
      "executionReceiptIsSecurityAttestation": false,
      "agentsMayAuthorExecutionReceipts": true
    },
    "generation": {
      "writeScope": "assigned-domain-only",
      "mayApproveRelease": false
    },
    "preflight": {
      "readOnlySourceAndMedia": true,
      "writeScope": "preflight-report-only",
      "mayApproveRelease": false
    },
    "reviewers": {
      "isolated": true,
      "readOnlySourceAndMedia": true,
      "writeScope": "own-report-only",
      "mayApproveRelease": false
    },
    "arbiter": {
      "isolated": true,
      "readOnlySourceAndMedia": true,
      "writeScope": "decision-and-authorized-deduplicated-product-linear-defects-only",
      "mayApproveExternalPublication": false
    },
    "remediation": {
      "writeScope": "validated-assignment-files-only",
      "mayApproveRelease": false,
      "destructiveGitAllowed": false,
      "forcePushAllowed": false,
      "broadWorkspaceWritesAllowed": false,
      "mayDeleteSourceEvidence": false
    },
    "finalVerifier": {
      "isolated": true,
      "readOnlySourceAndMedia": true,
      "writeScope": "own-verification-report-only",
      "mayApproveExternalPublication": false,
      "mandatoryTerminalGate": true,
      "runsAfterArbiterPass": true
    }
  },
  "deterministicEvidence": {
    "allowedGeneratorsByReportType": {
      "mediaMetadata": [
        "product-demo-studio-technical-checks"
      ],
      "framesAndContactSheets": [
        "product-demo-studio-technical-checks"
      ],
      "sceneBoundaries": [
        "product-demo-studio-technical-checks",
        "repository-native-playwright"
      ],
      "frameIntegrity": [
        "product-demo-studio-technical-checks"
      ],
      "audioQuality": [
        "product-demo-studio-technical-checks"
      ],
      "asrWordTimestamps": [
        "repository-native-asr"
      ],
      "captionTimingAndLayout": [
        "repository-native-caption-validator"
      ],
      "ocrVisibleText": [
        "repository-native-ocr"
      ],
      "motionAnalysis": [
        "product-demo-studio-technical-checks"
      ],
      "browserPlayback": [
        "repository-native-playwright"
      ],
      "browserConsole": [
        "repository-native-playwright"
      ],
      "browserNetwork": [
        "repository-native-playwright"
      ],
      "technicalDelivery": [
        "product-demo-studio-technical-checks"
      ],
      "claimVerification": [
        "repository-native-claim-validator"
      ],
      "truthSheetVerification": [
        "repository-native-truth-sheet-validator"
      ],
      "craftContractValidation": [
        "product-demo-studio-craft-contract-validator"
      ]
    },
    "unregisteredGeneratorDecision": "PIPELINE_BLOCKED",
    "manualPassAllowed": false
  },
  "releasePolicy": {
    "decisions": [
      "PASS",
      "REMEDIATE",
      "PRODUCT_BLOCKED",
      "PIPELINE_BLOCKED"
    ],
    "maximumBlockerFindings": 0,
    "maximumCriticalFindings": 0,
    "minimumStoryExperienceScore": 85,
    "minimumAudioCaptionsSynchronizationScore": 95,
    "completePassChecks": [
      "accuracy",
      "compliance",
      "privacy",
      "technicalIntegrity",
      "browserPlayback",
      "claims",
      "checksums",
      "provenance",
      "captions",
      "synchronization",
      "visualIntegrity"
    ],
    "terminalIndependentReview": {
      "required": true,
      "role": "final-verifier",
      "runsAfter": "arbiter-pass",
      "freshReadOnlyContextRequired": true,
      "reviewerShellAccessRequired": false,
      "deterministicBindingEnforcement": "host-post-validator",
      "mustBindExactFinalCandidate": true,
      "publicationPackagingRequiresPass": true,
      "failureDecision": "PIPELINE_BLOCKED"
    }
  },
  "rerunPolicy": {
    "newCandidateAfterRelevantChange": true,
    "regenerateEvidence": true,
    "freshReviewerContexts": true,
    "freshFinalIndependentReviewAfterEveryArbiterPass": true,
    "alwaysRerun": [
      "technical-frame-integrity",
      "audio-captions-synchronization",
      "screen-accuracy-compliance"
    ],
    "reusePreviousPassesAllowed": false,
    "weakenThresholdsAllowed": false
  }
}
