{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentHub Slack canonical tools",
  "protocol": "2025-11-25",
  "owner": "packages/slack",
  "note": "This file is the agent-facing contract. Hosts must expose these names and input schemas. slackContractHash is sha256 of sorted tool names plus canonical JSON of each input schema.",
  "tools": [
    {
      "name": "slack_search",
      "description": "Search messages and files. Returns canonical objects with IDs preserved.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["query"],
        "properties": {
          "query": { "type": "string", "minLength": 1 },
          "count": { "type": "integer", "minimum": 1, "maximum": 100 },
          "page": { "type": "integer", "minimum": 1 },
          "sort": { "type": "string", "enum": ["score", "timestamp"] }
        }
      }
    },
    {
      "name": "slack_channels",
      "description": "List conversations the authenticated actor can see.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "types": { "type": "string" },
          "limit": { "type": "integer", "minimum": 1, "maximum": 200 },
          "cursor": { "type": "string" },
          "exclude_archived": { "type": "boolean" }
        }
      }
    },
    {
      "name": "slack_users",
      "description": "List or lookup users. Never drop user_id when a display name is present.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "query": { "type": "string" },
          "user_id": { "type": "string" },
          "email": { "type": "string" },
          "limit": { "type": "integer", "minimum": 1, "maximum": 200 },
          "cursor": { "type": "string" }
        }
      }
    },
    {
      "name": "slack_messages",
      "description": "Read channel history. Pagination must be reproducible from cursor.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["channel_id"],
        "properties": {
          "channel_id": { "type": "string", "minLength": 1 },
          "oldest": { "type": "string" },
          "latest": { "type": "string" },
          "limit": { "type": "integer", "minimum": 1, "maximum": 200 },
          "cursor": { "type": "string" },
          "inclusive": { "type": "boolean" }
        }
      }
    },
    {
      "name": "slack_thread",
      "description": "Read a complete thread by channel_id + ts.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["channel_id", "ts"],
        "properties": {
          "channel_id": { "type": "string", "minLength": 1 },
          "ts": { "type": "string", "minLength": 1 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 200 },
          "cursor": { "type": "string" }
        }
      }
    },
    {
      "name": "slack_post",
      "description": "Post a new message. Requires explicit user authorization for the destination.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["channel_id", "text"],
        "properties": {
          "channel_id": { "type": "string", "minLength": 1 },
          "text": { "type": "string" },
          "blocks": { "type": "array" },
          "attachments": { "type": "array" },
          "metadata": { "type": "object" },
          "actor_mode": { "type": "string", "enum": ["user", "agent_bot"] }
        }
      }
    },
    {
      "name": "slack_reply",
      "description": "Reply in a thread. Requires channel_id and thread_ts.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["channel_id", "thread_ts", "text"],
        "properties": {
          "channel_id": { "type": "string", "minLength": 1 },
          "thread_ts": { "type": "string", "minLength": 1 },
          "text": { "type": "string" },
          "blocks": { "type": "array" },
          "actor_mode": { "type": "string", "enum": ["user", "agent_bot"] }
        }
      }
    },
    {
      "name": "slack_update",
      "description": "Edit an existing message.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["channel_id", "ts", "text"],
        "properties": {
          "channel_id": { "type": "string", "minLength": 1 },
          "ts": { "type": "string", "minLength": 1 },
          "text": { "type": "string" },
          "blocks": { "type": "array" },
          "actor_mode": { "type": "string", "enum": ["user", "agent_bot"] }
        }
      }
    },
    {
      "name": "slack_delete",
      "description": "Delete a message. Irreversible. Requires explicit user authorization.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["channel_id", "ts"],
        "properties": {
          "channel_id": { "type": "string", "minLength": 1 },
          "ts": { "type": "string", "minLength": 1 },
          "actor_mode": { "type": "string", "enum": ["user", "agent_bot"] }
        }
      }
    },
    {
      "name": "slack_react",
      "description": "Add an emoji reaction to a message.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["channel_id", "ts", "name"],
        "properties": {
          "channel_id": { "type": "string", "minLength": 1 },
          "ts": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "actor_mode": { "type": "string", "enum": ["user", "agent_bot"] }
        }
      }
    },
    {
      "name": "slack_unreact",
      "description": "Remove an emoji reaction from a message.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["channel_id", "ts", "name"],
        "properties": {
          "channel_id": { "type": "string", "minLength": 1 },
          "ts": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "actor_mode": { "type": "string", "enum": ["user", "agent_bot"] }
        }
      }
    },
    {
      "name": "slack_file_get",
      "description": "Get file metadata and, when available, content. Preserves file_id.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file_id"],
        "properties": {
          "file_id": { "type": "string", "minLength": 1 }
        }
      }
    },
    {
      "name": "slack_file_upload",
      "description": "Upload a file to a channel or thread. Requires explicit user authorization.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["filename", "content_base64"],
        "properties": {
          "filename": { "type": "string", "minLength": 1 },
          "content_base64": { "type": "string", "minLength": 1 },
          "channel_id": { "type": "string" },
          "thread_ts": { "type": "string" },
          "title": { "type": "string" },
          "initial_comment": { "type": "string" },
          "actor_mode": { "type": "string", "enum": ["user", "agent_bot"] }
        }
      }
    },
    {
      "name": "slack_permalink",
      "description": "Get a permalink for a message.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["channel_id", "ts"],
        "properties": {
          "channel_id": { "type": "string", "minLength": 1 },
          "ts": { "type": "string", "minLength": 1 }
        }
      }
    },
    {
      "name": "slack_channel_info",
      "description": "Get conversation metadata by channel_id.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["channel_id"],
        "properties": {
          "channel_id": { "type": "string", "minLength": 1 }
        }
      }
    },
    {
      "name": "slack_user_info",
      "description": "Get a user by user_id. Display names are additive.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["user_id"],
        "properties": {
          "user_id": { "type": "string", "minLength": 1 }
        }
      }
    },
    {
      "name": "slack_whoami",
      "description": "Return the AgentHub Slack identity currently in use.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "actor_mode": { "type": "string", "enum": ["user", "agent_bot"] }
        }
      }
    },
    {
      "name": "slack_pin",
      "description": "Pin a message in a channel.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["channel_id", "ts"],
        "properties": {
          "channel_id": { "type": "string", "minLength": 1 },
          "ts": { "type": "string", "minLength": 1 },
          "actor_mode": { "type": "string", "enum": ["user", "agent_bot"] }
        }
      }
    },
    {
      "name": "slack_unpin",
      "description": "Unpin a message in a channel.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["channel_id", "ts"],
        "properties": {
          "channel_id": { "type": "string", "minLength": 1 },
          "ts": { "type": "string", "minLength": 1 },
          "actor_mode": { "type": "string", "enum": ["user", "agent_bot"] }
        }
      }
    },
    {
      "name": "slack_bookmarks",
      "description": "List, add, or remove channel bookmarks.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["channel_id", "action"],
        "properties": {
          "channel_id": { "type": "string", "minLength": 1 },
          "action": { "type": "string", "enum": ["list", "add", "remove"] },
          "bookmark_id": { "type": "string" },
          "title": { "type": "string" },
          "link": { "type": "string" },
          "actor_mode": { "type": "string", "enum": ["user", "agent_bot"] }
        }
      }
    },
    {
      "name": "slack_canvas_get",
      "description": "Read a Slack canvas by id. Returns structured content plus raw.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["canvas_id"],
        "properties": {
          "canvas_id": { "type": "string", "minLength": 1 }
        }
      }
    },
    {
      "name": "slack_list_items",
      "description": "Read Slack list items by list_id.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["list_id"],
        "properties": {
          "list_id": { "type": "string", "minLength": 1 },
          "cursor": { "type": "string" },
          "limit": { "type": "integer", "minimum": 1, "maximum": 200 }
        }
      }
    },
    {
      "name": "slack_api_read",
      "description": "Escape hatch for a read-only Slack Web API method on the allowlist.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["method"],
        "properties": {
          "method": { "type": "string", "minLength": 1 },
          "params": { "type": "object" }
        }
      }
    },
    {
      "name": "slack_api_write",
      "description": "Controlled escape hatch for a Slack Web API write. Requires approved=true and SLACK_BRIDGE_ALLOW_API_WRITE=true.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["method", "approved"],
        "properties": {
          "method": { "type": "string", "minLength": 1 },
          "params": { "type": "object" },
          "approved": { "type": "boolean" },
          "actor_mode": { "type": "string", "enum": ["user", "agent_bot"] }
        }
      }
    }
  ]
}
