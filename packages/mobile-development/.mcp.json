{
  "mcpServers": {
    "appium-mobile": {
      "command": "npx",
      "args": [
        "-y",
        "appium-mcp@1.97.1"
      ],
      "env": {
        "ANDROID_HOME": "${ANDROID_HOME}",
        "NO_UI": "true"
      }
    },
    "mobile-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "@mobilenext/mobile-mcp@1.0.17"
      ]
    }
  }
}
