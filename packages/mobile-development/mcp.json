{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "appium-mobile": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "appium-mcp@1.97.1"
      ],
      "env": {
        "NO_UI": "true"
      }
    },
    "mobile-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@mobilenext/mobile-mcp@1.0.17"
      ]
    }
  }
}
