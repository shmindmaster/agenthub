{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "title",
    "logline",
    "truth_summary"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "logline": {
      "type": "string"
    },
    "truth_summary": {
      "type": "string"
    },
    "technical_takeaway": {
      "type": "string"
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
