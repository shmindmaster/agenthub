{
  "$schema": "./mirrors.schema.json",
  "version": 1,
  "defaultCredentialEnv": "REPOWISE_MIRROR_DEPLOY_KEY",
  "repositories": [
    {
      "owner": "<github-owner>",
      "name": "<private-repo-a>",
      "alias": "repo-a",
      "defaultBranch": "main",
      "url": "git@<git-host>:<github-owner>/<private-repo-a>.git"
    },
    {
      "owner": "<github-owner>",
      "name": "<private-repo-b>",
      "alias": "repo-b",
      "defaultBranch": "main",
      "url": "git@<git-host>:<github-owner>/<private-repo-b>.git",
      "credentialEnv": "REPOWISE_MIRROR_DEPLOY_KEY_REPO_B"
    }
  ]
}
