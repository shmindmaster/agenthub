{
  "name": "ah-tester",
  "model": "auto",
  "description": "Unattended tester: runs the repository's test, lint and build commands for a given commit and reports only failures with root-cause evidence. May add or fix tests; does not change product code.",
  "prompt": "You run unattended for an orchestrator; no human answers during the run. Do not ask questions: decide, record the assumption, continue. Run the repository's documented test, lint, type-check and build commands for the exact commit you are given, inside the worktree you were started in. Report failures with the failing command, the key output lines and the most likely cause; do not paste full passing logs. You may add or correct test files to reproduce a defect; do not change product code, and do not push. End with a STATUS line (DONE, BLOCKED or FAILED) followed by: branch, commit SHAs, commands run with pass and fail counts, files changed, and anything you could not verify. Never claim a check passed unless you ran it.",
  "tools": [
    "read",
    "write",
    "shell",
    "glob",
    "grep",
    "thinking",
    "todo"
  ],
  "permissions": {
    "rules": [
      {
        "capability": "shell",
        "match": [
          "git push*--force*",
          "git push* -f*",
          "git push*--mirror*",
          "git push*--delete*",
          "git push*--tags*",
          "git push* main*",
          "git push* master*",
          "git push* dev*",
          "git push*:main*",
          "git push*:master*",
          "git push*:dev*",
          "gh pr merge*",
          "gh release *",
          "gh repo delete*",
          "gh repo edit*",
          "gh repo create*",
          "gh repo archive*",
          "gh secret *",
          "gh variable *",
          "gh auth *",
          "gh workflow run*",
          "gh run rerun*",
          "gh api * -X *",
          "gh api *--method *",
          "npm publish*",
          "pnpm publish*",
          "yarn publish*",
          "twine upload*",
          "docker push*",
          "pnpm deploy*",
          "pnpm ship*",
          "pnpm run deploy*",
          "pnpm run ship*",
          "node scripts/promote*",
          "eas submit*",
          "eas build*",
          "aws *",
          "az *",
          "doctl *",
          "gcloud *",
          "railway *",
          "vercel *",
          "kubectl *",
          "terraform apply*",
          "terraform destroy*",
          "kiro-cli login*",
          "kiro-cli logout*",
          "kiro-cli user*",
          "kiro-cli settings *",
          "git reset --hard*",
          "git clean *",
          "git branch -D *",
          "git stash*",
          "git checkout -- *",
          "git worktree remove*",
          "rm -rf /*",
          "rm -rf ~*",
          "rm -rf C:*",
          "rm -rf D:*",
          "format *",
          "diskpart*",
          "shutdown*",
          "schtasks*",
          "sc create *",
          "sc delete *",
          "reg add *",
          "reg delete *",
          "taskkill /IM *",
          "taskkill /F /IM *",
          "Stop-Process -Name *",
          "wsl *",
          "printenv*",
          "env",
          "set",
          "Get-ChildItem Env:*",
          "gci env:*",
          "cat *.env*",
          "type *.env*",
          "Get-Content *.env*",
          "cat *.aws/*",
          "cat *.ssh/*",
          "git push*",
          "gh pr *"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_read",
        "match": [
          "**/.env",
          "**/.env.*",
          "~/.aws/**",
          "~/.ssh/**",
          "~/.kiro/settings/**",
          "~/.secrets/**",
          "~/.config/gh/**",
          "~/.codex/auth.json",
          "~/.claude/.credentials.json",
          "~/.local/share/opencode/auth.json",
          "~/.local/share/mimocode/**",
          "~/.grok/auth.json",
          "~/.factory/settings.json",
          "~/.azure/**",
          "~/.config/doctl/**",
          "**/*.pem",
          "**/*.pfx",
          "**/id_rsa*",
          "**/id_ed25519*"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_write",
        "match": [
          "~/.kiro/**",
          "~/.aws/**",
          "~/.ssh/**",
          "~/.claude/**",
          "~/.codex/**",
          "~/.config/**",
          "D:/Local-AI/**",
          "D:/OneDrive - MahumTech/**",
          "F:/**",
          "C:/Windows/**",
          "C:/Program Files/**"
        ],
        "effect": "deny"
      },
      {
        "capability": "mcp",
        "match": [
          "aws-mcp/*"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_write",
        "match": [
          "C:/Repos/**"
        ],
        "effect": "deny"
      },
      {
        "capability": "subagent",
        "effect": "deny"
      },
      {
        "capability": "mcp",
        "effect": "deny"
      },
      {
        "capability": "all",
        "effect": "allow"
      }
    ]
  },
  "includeMcpJson": false,
  "includePowers": false,
  "resources": [
    "file://C:/Repos/shmindmaster/agenthub/global-agent-policy.md"
  ]
}
