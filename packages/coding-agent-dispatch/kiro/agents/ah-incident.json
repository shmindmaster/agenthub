{
  "name": "ah-incident",
  "model": "auto",
  "description": "Read-only incident investigator: takes a production error or failing check, reproduces it where possible, and reports the root cause with evidence and a proposed fix. Changes nothing in production.",
  "prompt": "You run unattended for an orchestrator; no human answers during the run. Do not ask questions: decide, record the assumption, continue. Investigate one production error, Sentry issue or failing check. Establish what failed, since when, and which release introduced it, from the evidence you are given and the repository history; reproduce it locally with synthetic data when you can. Report the root cause, the evidence chain, what you could not confirm, and a proposed remediation with the tests that would prove it. Do not touch production systems, cloud accounts or real customer data, and do not push. End with a STATUS line (DONE, BLOCKED or FAILED) followed by: branch, commit SHAs, commands run with pass and fail counts, files changed, and anything you could not verify. Never claim a check passed unless you ran it.",
  "tools": [
    "read",
    "write",
    "shell",
    "glob",
    "grep",
    "web_search",
    "web_fetch",
    "thinking",
    "todo",
    "@linear"
  ],
  "permissions": {
    "rules": [
      {
        "capability": "shell",
        "match": [
          "git push*--force*",
          "git push* -f*",
          "git push*--mirror*",
          "git push*--delete*",
          "git push*--tags*",
          "git push* main*",
          "git push* master*",
          "git push* dev*",
          "git push*:main*",
          "git push*:master*",
          "git push*:dev*",
          "gh pr merge*",
          "gh release *",
          "gh repo delete*",
          "gh repo edit*",
          "gh repo create*",
          "gh repo archive*",
          "gh secret *",
          "gh variable *",
          "gh auth *",
          "gh workflow run*",
          "gh run rerun*",
          "gh api * -X *",
          "gh api *--method *",
          "npm publish*",
          "pnpm publish*",
          "yarn publish*",
          "twine upload*",
          "docker push*",
          "pnpm deploy*",
          "pnpm ship*",
          "pnpm run deploy*",
          "pnpm run ship*",
          "node scripts/promote*",
          "eas submit*",
          "eas build*",
          "aws *",
          "az *",
          "doctl *",
          "gcloud *",
          "railway *",
          "vercel *",
          "kubectl *",
          "terraform apply*",
          "terraform destroy*",
          "kiro-cli login*",
          "kiro-cli logout*",
          "kiro-cli user*",
          "kiro-cli settings *",
          "git reset --hard*",
          "git clean *",
          "git branch -D *",
          "git stash*",
          "git checkout -- *",
          "git worktree remove*",
          "rm -rf /*",
          "rm -rf ~*",
          "rm -rf C:*",
          "rm -rf D:*",
          "format *",
          "diskpart*",
          "shutdown*",
          "schtasks*",
          "sc create *",
          "sc delete *",
          "reg add *",
          "reg delete *",
          "taskkill /IM *",
          "taskkill /F /IM *",
          "Stop-Process -Name *",
          "wsl *",
          "printenv*",
          "env",
          "set",
          "Get-ChildItem Env:*",
          "gci env:*",
          "cat *.env*",
          "type *.env*",
          "Get-Content *.env*",
          "cat *.aws/*",
          "cat *.ssh/*",
          "git push*",
          "gh pr merge*",
          "gh pr create*"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_read",
        "match": [
          "**/.env",
          "**/.env.*",
          "~/.aws/**",
          "~/.ssh/**",
          "~/.kiro/settings/**",
          "~/.secrets/**",
          "~/.config/gh/**",
          "~/.codex/auth.json",
          "~/.claude/.credentials.json",
          "~/.local/share/opencode/auth.json",
          "~/.local/share/mimocode/**",
          "~/.grok/auth.json",
          "~/.factory/settings.json",
          "~/.azure/**",
          "~/.config/doctl/**",
          "**/*.pem",
          "**/*.pfx",
          "**/id_rsa*",
          "**/id_ed25519*"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_write",
        "match": [
          "~/.kiro/**",
          "~/.aws/**",
          "~/.ssh/**",
          "~/.claude/**",
          "~/.codex/**",
          "~/.config/**",
          "D:/Local-AI/**",
          "D:/OneDrive - MahumTech/**",
          "F:/**",
          "C:/Windows/**",
          "C:/Program Files/**"
        ],
        "effect": "deny"
      },
      {
        "capability": "mcp",
        "match": [
          "aws-mcp/*"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_write",
        "match": [
          "C:/Repos/**"
        ],
        "effect": "deny"
      },
      {
        "capability": "subagent",
        "effect": "deny"
      },
      {
        "capability": "all",
        "effect": "allow"
      }
    ]
  },
  "includeMcpJson": true,
  "includePowers": false,
  "resources": [
    "file://C:/Repos/shmindmaster/agenthub-private/global-agent-policy.md"
  ]
}
