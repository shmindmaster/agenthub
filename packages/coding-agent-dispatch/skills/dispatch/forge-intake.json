{
  "version": 1,
  "linear": {
    "claimLabel": "agent:forge",
    "pickStates": ["Ready"],
    "claimedState": "In Progress",
    "reviewState": "In Review",
    "includeLabelsAny": ["Bug", "Maintenance", "Improvement"],
    "excludeLabelPatterns": ["Decision", "Research", "type:epic", "type:research", "attention:*", "agent:*", "risk:compliance", "risk:security", "stage:*", "lane:*", "funding:*"],
    "staleClaimHours": 8,
    "mcpUrl": "https://mcp.linear.app/mcp",
    "toolsByPhase": {
      "select": ["get_team", "get_issue", "list_issues"],
      "implement": ["get_issue", "list_comments"],
      "refresh": ["get_team"]
    }
  },
  "repos": {
    "app:agenthub": {
      "repo": "shmindmaster/agenthub",
      "base": "main",
      "protectedPaths": [".github/", "registry/", ".agents/", ".claude-plugin/", ".gitmodules", "AGENTS.md", "CLAUDE.md", ".mcp.json", "packages/*/hooks/*", "packages/*/.mcp.json", "packages/*/mcp.json", "packages/*/mcp_config.json"]
    }
  },
  "limits": {
    "maxRunsPerDay": 6,
    "maxSelectsPerDay": 24,
    "maxAttemptsPerIssue": 2,
    "maxFiles": 30,
    "maxChangedLines": 1200,
    "minFreeMemMiB": 4096,
    "selectSeconds": 600,
    "implementSeconds": 2400,
    "keepRunDays": 14
  },
  "routes": [
    {"id": "codex-zai", "launcher": ".local/bin/codex-zai", "plan": "Z.ai Coding Plan", "enabled": true},
    {"id": "codex-qwen", "launcher": ".local/bin/codex-qwen", "plan": "Qwen Token Plan", "enabled": true},
    {"id": "codex-go", "launcher": ".local/bin/codex-go", "plan": "OpenCode Go", "enabled": true},
    {"id": "codex-mimo", "launcher": ".local/bin/codex-mimo", "plan": "MiMo Token Plan", "enabled": false}
  ]
}
