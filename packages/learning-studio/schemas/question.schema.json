{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "stem",
    "answer",
    "why"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "stem": {
      "type": "string"
    },
    "choices": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "answer": {
      "type": "string"
    },
    "why": {
      "type": "string"
    },
    "memory_hook": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
