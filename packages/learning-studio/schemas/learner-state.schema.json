{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "learner_id",
    "items"
  ],
  "properties": {
    "learner_id": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "question_id",
          "correct",
          "confidence"
        ],
        "properties": {
          "question_id": {
            "type": "string"
          },
          "correct": {
            "type": "boolean"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "knew-it",
              "unsure",
              "guessed",
              "no-clue"
            ]
          }
        }
      }
    }
  }
}
