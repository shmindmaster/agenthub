# OpenConnector runtime environment -- variable NAMES only.
# Copy to %LOCALAPPDATA%\AgentHub\runtime\open-connector\.env and fill values
# there. That file is outside every repository and is never committed.

# Host-side loopback port. 3000 is Duckie, 7337/7338 are RepoWise.
OPEN_CONNECTOR_PORT=3400

# Bind-mounted as /app/data: SQLite database, transit files, upload staging.
OPEN_CONNECTOR_DATA_DIR=C:\Users\<you>\AppData\Local\AgentHub\runtime\open-connector\data

# Long random secrets. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Losing the encryption key makes every stored credential unrecoverable.
OPEN_CONNECTOR_ENCRYPTION_KEY=
OPEN_CONNECTOR_ADMIN_TOKEN=
OPEN_CONNECTOR_RUNTIME_TOKEN=

# Optional overrides (defaults live in docker-compose.yml).
# OPEN_CONNECTOR_ALLOWED_ACTIONS=github.*,linear.*
# OPEN_CONNECTOR_ALLOWED_PROXIES=
# OPEN_CONNECTOR_BLOCKED_PROXIES=*
# OPEN_CONNECTOR_ALLOWED_CUSTOM_OAUTH=
# OPEN_CONNECTOR_DATABASE_URL=postgres://user:pass@host:5432/open_connector
# OPEN_CONNECTOR_LOG_LEVEL=info
