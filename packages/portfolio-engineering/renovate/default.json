{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Portfolio dependency policy: bounded reviewed updates, no automatic merging",
  "extends": ["config:recommended"],
  "automerge": false,
  "prConcurrentLimit": 2,
  "prHourlyLimit": 1,
  "dependencyDashboard": true,
  "separateMajorMinor": true,
  "rangeStrategy": "auto",
  "packageRules": [
    {"matchUpdateTypes": ["major"], "dependencyDashboardApproval": true},
    {"matchManagers": ["npm"], "matchDepTypes": ["devDependencies"], "matchUpdateTypes": ["minor", "patch"], "groupName": "compatible development dependencies"}
  ]
}
