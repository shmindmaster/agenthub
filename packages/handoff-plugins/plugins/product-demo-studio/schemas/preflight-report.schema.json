{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenthub.local/schemas/product-video/preflight-report.schema.json",
  "title": "Product Video Automated Preflight Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reportId",
    "candidateId",
    "evidencePackage",
    "policyVersion",
    "startedAt",
    "completedAt",
    "checks",
    "failures",
    "summary",
    "status",
    "readyForIndependentReview"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "reportId": {
      "type": "string",
      "pattern": "^PVP-[A-Z0-9][A-Z0-9-]*-[0-9]{3,}$"
    },
    "candidateId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "evidencePackage": {
      "$ref": "#/$defs/artifactReference"
    },
    "policyVersion": {
      "const": "1.0.0"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time"
    },
    "checks": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/preflightCheck"
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "id": {
                "const": "artifact-completeness"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "script-narration-caption-parity"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "names-dates-numbers-claims"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "caption-overflow-obstruction-speed-safe-areas"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "audio-loudness"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "audio-clipping"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "audio-silence"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "frame-black"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "frame-frozen"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "frame-duplicate"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "frame-corruption"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "asset-completeness"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "browser-console-network"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "render-errors"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "output-specifications"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "checksums-provenance"
              }
            },
            "required": [
              "id"
            ]
          }
        }
      ]
    },
    "failures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/preflightFailure"
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "passed",
        "failed"
      ],
      "properties": {
        "total": {
          "const": 16
        },
        "passed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "failed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        }
      }
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "readyForIndependentReview": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "PASS"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "failures": {
            "maxItems": 0
          },
          "readyForIndependentReview": {
            "const": true
          },
          "summary": {
            "properties": {
              "passed": {
                "const": 16
              },
              "failed": {
                "const": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "FAIL"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "failures": {
            "minItems": 1
          },
          "readyForIndependentReview": {
            "const": false
          }
        }
      }
    }
  ],
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactPath",
        "sha256"
      ],
      "properties": {
        "artifactPath": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "subsystem": {
      "enum": [
        "story-script",
        "product-seed-data",
        "capture-playwright",
        "remotion-composition",
        "narration-audio",
        "captions",
        "export-pipeline",
        "infrastructure-assets"
      ]
    },
    "checkId": {
      "enum": [
        "artifact-completeness",
        "script-narration-caption-parity",
        "names-dates-numbers-claims",
        "caption-overflow-obstruction-speed-safe-areas",
        "audio-loudness",
        "audio-clipping",
        "audio-silence",
        "frame-black",
        "frame-frozen",
        "frame-duplicate",
        "frame-corruption",
        "asset-completeness",
        "browser-console-network",
        "render-errors",
        "output-specifications",
        "checksums-provenance"
      ]
    },
    "preflightCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "subsystem",
        "passed",
        "evidenceArtifactIds"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/checkId"
        },
        "subsystem": {
          "$ref": "#/$defs/subsystem"
        },
        "passed": {
          "type": "boolean"
        },
        "evidenceArtifactIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          }
        }
      }
    },
    "preflightFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "checkId",
        "subsystem",
        "severity",
        "expectedBehavior",
        "observedBehavior",
        "evidenceArtifactIds",
        "concreteFix",
        "validationCommand"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^PVF-PREFLIGHT-[0-9]{3,}$"
        },
        "checkId": {
          "$ref": "#/$defs/checkId"
        },
        "subsystem": {
          "$ref": "#/$defs/subsystem"
        },
        "severity": {
          "enum": [
            "blocker",
            "critical",
            "major"
          ]
        },
        "expectedBehavior": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "observedBehavior": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "evidenceArtifactIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          }
        },
        "concreteFix": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "validationCommand": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    }
  }
}
