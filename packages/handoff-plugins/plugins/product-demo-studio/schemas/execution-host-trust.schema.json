{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenthub.local/schemas/product-video/execution-host-trust.schema.json",
  "title": "Product Video Trusted Execution Host Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "hosts"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "hosts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/host"
      }
    }
  },
  "$defs": {
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "role": {
      "enum": [
        "reviewer",
        "arbiter",
        "final-verifier"
      ]
    },
    "mechanism": {
      "enum": [
        "host-native-read-only-context",
        "os-filesystem-read-only-sandbox",
        "container-read-only-mount",
        "virtual-machine-read-only-snapshot"
      ]
    },
    "readOnlyToolClass": {
      "enum": [
        "filesystem-read",
        "filesystem-search",
        "structured-data-read",
        "media-inspect",
        "browser-playback-read",
        "process-inspect",
        "version-control-read",
        "github-read",
        "notion-read",
        "linear-read",
        "checksum"
      ]
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hostId",
        "keyId",
        "enabled",
        "publicKeyPath",
        "publicKeySha256",
        "allowedRoles",
        "allowedMechanisms",
        "allowedReadOnlyTools"
      ],
      "properties": {
        "hostId": {
          "$ref": "#/$defs/safeId"
        },
        "keyId": {
          "$ref": "#/$defs/safeId"
        },
        "enabled": {
          "type": "boolean"
        },
        "publicKeyPath": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "publicKeySha256": {
          "$ref": "#/$defs/sha256"
        },
        "allowedRoles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/role"
          }
        },
        "allowedMechanisms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/mechanism"
          }
        },
        "allowedReadOnlyTools": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/readOnlyToolClass"
          }
        }
      }
    }
  }
}
