{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenthub.local/schemas/product-video/release-decision.schema.json",
  "title": "Product Video Release Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "decisionId",
    "arbiter",
    "policy",
    "decision",
    "rationale",
    "decidedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "decisionId": {
      "type": "string",
      "pattern": "^PVD-[A-Z0-9][A-Z0-9-]*-[0-9]{3,}$"
    },
    "candidate": {
      "$ref": "#/$defs/candidateReference"
    },
    "arbiter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contextId",
        "readOnly",
        "executionReceipt"
      ],
      "properties": {
        "contextId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "readOnly": {
          "const": true
        },
        "executionReceipt": {
          "$ref": "#/$defs/executionReceiptReference"
        }
      }
    },
    "policy": {
      "$ref": "#/$defs/policyReference"
    },
    "preflight": {
      "$ref": "#/$defs/preflightReference"
    },
    "reviewReports": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/reviewReportReference"
      }
    },
    "releaseChecks": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "findingDispositions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/findingDisposition"
      }
    },
    "evidenceValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allReportsValidated",
        "unsupportedFindingsRejected",
        "overlapsDeduplicated",
        "contradictionsResolved"
      ],
      "properties": {
        "allReportsValidated": {
          "type": "boolean"
        },
        "unsupportedFindingsRejected": {
          "type": "boolean"
        },
        "overlapsDeduplicated": {
          "type": "boolean"
        },
        "contradictionsResolved": {
          "type": "boolean"
        }
      }
    },
    "decision": {
      "enum": [
        "PASS",
        "REMEDIATE",
        "PRODUCT_BLOCKED",
        "PIPELINE_BLOCKED"
      ]
    },
    "remediationPlan": {
      "$ref": "#/$defs/remediationPlan"
    },
    "blocker": {
      "$ref": "#/$defs/blocker"
    },
    "rationale": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "decidedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "enum": [
              "PASS",
              "REMEDIATE"
            ]
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "required": [
          "candidate",
          "preflight",
          "reviewReports",
          "releaseChecks",
          "findingDispositions",
          "evidenceValidation"
        ],
        "not": {
          "required": [
            "blocker"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "REMEDIATE"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "required": [
          "remediationPlan"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "PASS"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "not": {
          "required": [
            "remediationPlan"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "enum": [
              "PRODUCT_BLOCKED",
              "PIPELINE_BLOCKED"
            ]
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "required": [
          "blocker"
        ],
        "not": {
          "required": [
            "remediationPlan"
          ]
        }
      }
    }
  ],
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "reviewDomain": {
      "enum": [
        "story-experience",
        "screen-accuracy-compliance",
        "audio-captions-synchronization",
        "technical-frame-integrity"
      ]
    },
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactPath",
        "sha256"
      ],
      "properties": {
        "artifactPath": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "executionReceiptReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt",
        "signature"
      ],
      "properties": {
        "receipt": {
          "$ref": "#/$defs/executionReceiptArtifactReference"
        },
        "signature": {
          "$ref": "#/$defs/executionReceiptSignatureReference"
        }
      }
    },
    "executionReceiptArtifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactPath",
        "sha256",
        "bytes"
      ],
      "properties": {
        "artifactPath": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "executionReceiptSignatureReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactPath",
        "sha256",
        "bytes"
      ],
      "properties": {
        "artifactPath": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "const": 64
        }
      }
    },
    "candidateReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateId",
        "artifactPath",
        "sha256",
        "bytes",
        "sourceRevision",
        "renderProvenanceId"
      ],
      "properties": {
        "candidateId": {
          "$ref": "#/$defs/safeId"
        },
        "artifactPath": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sourceRevision": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "renderProvenanceId": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "policyReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactPath",
        "sha256",
        "policyVersion"
      ],
      "properties": {
        "artifactPath": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "policyVersion": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "preflightReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactPath",
        "sha256"
      ],
      "properties": {
        "artifactPath": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "completeReviewReportReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "reportPath",
        "sha256",
        "status",
        "score",
        "passed",
        "findingCount",
        "blockerFindings",
        "criticalFindings"
      ],
      "properties": {
        "domain": {
          "$ref": "#/$defs/reviewDomain"
        },
        "reportPath": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "status": {
          "const": "COMPLETE"
        },
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "passed": {
          "type": "boolean"
        },
        "findingCount": {
          "type": "integer",
          "minimum": 0
        },
        "blockerFindings": {
          "type": "integer",
          "minimum": 0
        },
        "criticalFindings": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "malformedReviewReportReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "reportPath",
        "sha256",
        "status"
      ],
      "properties": {
        "domain": {
          "$ref": "#/$defs/reviewDomain"
        },
        "reportPath": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "status": {
          "const": "MALFORMED_INPUT"
        }
      }
    },
    "reviewReportReference": {
      "anyOf": [
        {
          "$ref": "#/$defs/completeReviewReportReference"
        },
        {
          "$ref": "#/$defs/malformedReviewReportReference"
        }
      ]
    },
    "findingDisposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "findingId",
        "disposition",
        "rationale",
        "evidenceArtifactIds"
      ],
      "properties": {
        "findingId": {
          "type": "string",
          "pattern": "^PVF-[A-Z0-9][A-Z0-9-]*-[0-9]{3,}$"
        },
        "disposition": {
          "enum": [
            "accepted",
            "rejected-unsupported",
            "duplicate"
          ]
        },
        "canonicalFindingId": {
          "type": "string",
          "pattern": "^PVF-[A-Z0-9][A-Z0-9-]*-[0-9]{3,}$"
        },
        "rationale": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "evidenceArtifactIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/safeId"
          }
        }
      }
    },
    "remediationPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "findingIds",
        "assignmentPaths"
      ],
      "properties": {
        "findingIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^PVF-[A-Z0-9][A-Z0-9-]*-[0-9]{3,}$"
          }
        },
        "assignmentPaths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "blockerEvidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceType",
        "artifactPath",
        "sha256",
        "immutable"
      ],
      "properties": {
        "evidenceType": {
          "enum": [
            "readiness",
            "preflight"
          ]
        },
        "artifactPath": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "immutable": {
          "const": true
        }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "summary",
        "evidence"
      ],
      "properties": {
        "classification": {
          "enum": [
            "product",
            "pipeline"
          ]
        },
        "summary": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/blockerEvidenceReference"
          }
        }
      }
    }
  }
}
