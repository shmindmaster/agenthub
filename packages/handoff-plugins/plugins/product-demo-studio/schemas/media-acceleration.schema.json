{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenthub.local/schemas/product-video/media-acceleration.schema.json",
  "title": "Product Video Media Acceleration Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "detectedAt", "mode", "nvidia", "ffmpeg", "inference", "selection", "fallbackReason"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "detectedAt": { "type": "string", "format": "date-time" },
    "mode": { "enum": ["gpu-preferred", "cpu-fallback"] },
    "nvidia": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "name", "driverVersion", "cudaVersion", "memoryMiB"],
      "properties": {
        "available": { "type": "boolean" },
        "name": { "type": ["string", "null"] },
        "driverVersion": { "type": ["string", "null"] },
        "cudaVersion": { "type": ["string", "null"] },
        "memoryMiB": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "ffmpeg": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "nvencEncoders", "usableNvencEncoders"],
      "properties": {
        "available": { "type": "boolean" },
        "nvencEncoders": {
          "type": "array",
          "items": { "enum": ["av1_nvenc", "hevc_nvenc", "h264_nvenc"] }
        },
        "usableNvencEncoders": {
          "type": "array",
          "items": { "enum": ["av1_nvenc", "hevc_nvenc", "h264_nvenc"] }
        }
      }
    },
    "inference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "available", "cudaUsable", "detail"],
      "properties": {
        "engine": { "type": ["string", "null"] },
        "available": { "type": "boolean" },
        "cudaUsable": { "type": "boolean" },
        "detail": { "type": "string" }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["videoEncoder", "mediaInferenceDevice"],
      "properties": {
        "videoEncoder": { "type": "string", "minLength": 1 },
        "mediaInferenceDevice": { "enum": ["cuda", "cpu"] }
      }
    },
    "fallbackReason": {
      "type": ["string", "null"]
    }
  }
}
