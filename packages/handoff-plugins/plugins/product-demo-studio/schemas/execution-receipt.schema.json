{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenthub.local/schemas/product-video/execution-receipt.schema.json",
  "title": "Product Video Host-Enforced Read-Only Execution Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "receiptId",
    "immutable",
    "role",
    "contextId",
    "candidateId",
    "hostId",
    "mechanism",
    "readOnly",
    "writeTools",
    "permittedReadOnlyTools",
    "startedAt",
    "completedAt",
    "issuedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "receiptId": {
      "type": "string",
      "pattern": "^PVE-[A-Z0-9][A-Z0-9-]*-[0-9]{3,}$"
    },
    "immutable": {
      "const": true
    },
    "role": {
      "enum": [
        "reviewer",
        "arbiter",
        "final-verifier"
      ]
    },
    "domain": {
      "$ref": "#/$defs/reviewDomain"
    },
    "contextId": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "candidateId": {
      "$ref": "#/$defs/safeId"
    },
    "hostId": {
      "$ref": "#/$defs/safeId"
    },
    "mechanism": {
      "enum": [
        "host-native-read-only-context",
        "os-filesystem-read-only-sandbox",
        "container-read-only-mount",
        "virtual-machine-read-only-snapshot"
      ]
    },
    "readOnly": {
      "const": true
    },
    "writeTools": {
      "type": "array",
      "maxItems": 0
    },
    "permittedReadOnlyTools": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/readOnlyToolClass"
      }
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time"
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "inputArtifactSha256": {
      "$ref": "#/$defs/sha256"
    },
    "resultPayloadSha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "role": {
            "const": "reviewer"
          }
        },
        "required": [
          "role"
        ]
      },
      "then": {
        "required": [
          "domain"
        ]
      },
      "else": {
        "not": {
          "required": [
            "domain"
          ]
        }
      }
    }
  ],
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reviewDomain": {
      "enum": [
        "story-experience",
        "screen-accuracy-compliance",
        "audio-captions-synchronization",
        "technical-frame-integrity"
      ]
    },
    "readOnlyToolClass": {
      "enum": [
        "filesystem-read",
        "filesystem-search",
        "structured-data-read",
        "media-inspect",
        "browser-playback-read",
        "process-inspect",
        "version-control-read",
        "github-read",
        "notion-read",
        "linear-read",
        "checksum"
      ]
    }
  }
}
