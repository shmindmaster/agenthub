{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenthub.local/schemas/product-video/interactive-deep-dive.schema.json",
  "title": "Interactive Product Deep-Dive Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "experienceId",
    "narrativeAnchor",
    "personas",
    "proofAssets",
    "scenes",
    "navigation",
    "instrumentation",
    "safety"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "experienceId": {
      "$ref": "#/$defs/id"
    },
    "narrativeAnchor": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "personas": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/persona"
      }
    },
    "proofAssets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/proofAsset"
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 5,
      "maxItems": 15,
      "items": {
        "$ref": "#/$defs/scene"
      }
    },
    "navigation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "personaRouter",
        "stickyJourneyProgress",
        "directSceneLinks",
        "persistentContextualCta",
        "safeAreaValidated"
      ],
      "properties": {
        "personaRouter": { "const": true },
        "stickyJourneyProgress": { "const": true },
        "directSceneLinks": { "const": true },
        "persistentContextualCta": { "const": true },
        "safeAreaValidated": { "const": true }
      }
    },
    "instrumentation": {
      "type": "array",
      "minItems": 4,
      "items": {
        "enum": [
          "role_selected",
          "scene_viewed",
          "proof_interacted",
          "cta_clicked",
          "sandbox_started",
          "media_completed"
        ]
      },
      "allOf": [
        { "contains": { "const": "role_selected" } },
        { "contains": { "const": "scene_viewed" } },
        { "contains": { "const": "proof_interacted" } },
        { "contains": { "const": "cta_clicked" } }
      ]
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "syntheticDataOnly",
        "noExternalSideEffects",
        "keyboardAccessible",
        "reducedMotionSupported",
        "sandboxIsolation"
      ],
      "properties": {
        "syntheticDataOnly": { "const": true },
        "noExternalSideEffects": { "const": true },
        "keyboardAccessible": { "const": true },
        "reducedMotionSupported": { "const": true },
        "sandboxIsolation": { "const": "synthetic-only" }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "persona": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "outcome", "cta"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "$ref": "#/$defs/nonEmptyString" },
        "outcome": { "$ref": "#/$defs/nonEmptyString" },
        "cta": {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "destination"],
          "properties": {
            "label": { "$ref": "#/$defs/nonEmptyString" },
            "destination": { "$ref": "#/$defs/nonEmptyString" }
          }
        }
      }
    },
    "proofAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "path", "sha256", "evidenceIds", "posterFallback"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": {
          "enum": ["interactive-hotspots", "video-loop", "synthetic-sandbox"]
        },
        "path": { "$ref": "#/$defs/nonEmptyString" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/id" }
        },
        "posterFallback": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "value", "evidenceId"],
      "properties": {
        "label": { "$ref": "#/$defs/nonEmptyString" },
        "value": { "$ref": "#/$defs/nonEmptyString" },
        "evidenceId": { "$ref": "#/$defs/id" }
      }
    },
    "automationDisclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceClasses", "confidenceLabel", "limitations", "humanControl"],
      "properties": {
        "sourceClasses": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "confidenceLabel": { "$ref": "#/$defs/nonEmptyString" },
        "limitations": { "$ref": "#/$defs/nonEmptyString" },
        "humanControl": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sequence",
        "phase",
        "title",
        "personaIds",
        "deepLink",
        "proofAssetId",
        "trustControl",
        "metrics"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 15
        },
        "phase": { "$ref": "#/$defs/nonEmptyString" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "personaIds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/id" }
        },
        "deepLink": {
          "type": "string",
          "pattern": "^#[a-z0-9][a-z0-9-]*$"
        },
        "proofAssetId": { "$ref": "#/$defs/id" },
        "trustControl": { "$ref": "#/$defs/nonEmptyString" },
        "metrics": {
          "type": "array",
          "items": { "$ref": "#/$defs/metric" }
        },
        "automationDisclosure": {
          "$ref": "#/$defs/automationDisclosure"
        }
      }
    }
  }
}
