{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenthub.local/schemas/product-video/release-evidence.schema.json",
  "title": "Product Video Signed Publication Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "candidateId",
    "assetPath",
    "sha256",
    "bytes",
    "arbiterDecision",
    "finalVerification",
    "approvalReceipt",
    "approvalSignature"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0.0"
    },
    "candidateId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "assetPath": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "sha256": {
      "$ref": "#/$defs/sha256"
    },
    "bytes": {
      "$ref": "#/$defs/bytes"
    },
    "arbiterDecision": {
      "$ref": "#/$defs/artifactReference"
    },
    "finalVerification": {
      "$ref": "#/$defs/artifactReference"
    },
    "approvalReceipt": {
      "$ref": "#/$defs/artifactReference"
    },
    "approvalSignature": {
      "$ref": "#/$defs/artifactReference"
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "bytes": {
      "type": "integer",
      "minimum": 1
    },
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactPath",
        "sha256",
        "bytes"
      ],
      "properties": {
        "artifactPath": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "$ref": "#/$defs/bytes"
        }
      }
    }
  }
}
