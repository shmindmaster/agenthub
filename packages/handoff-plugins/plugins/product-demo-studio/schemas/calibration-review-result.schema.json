{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenthub.local/schemas/product-video/calibration-review-result.schema.json",
  "title": "Product Video Calibration Reviewer Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "fixtureId",
    "candidateId",
    "reviewDomain",
    "modelId",
    "contextId",
    "startedAt",
    "completedAt",
    "executionReceipt",
    "checks",
    "verdict"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "fixtureId": { "$ref": "reviewer-calibration.schema.json#/$defs/fixtureId" },
    "candidateId": { "$ref": "#/$defs/safeId" },
    "reviewDomain": { "$ref": "reviewer-calibration.schema.json#/$defs/reviewDomain" },
    "modelId": { "$ref": "#/$defs/nonEmptyString" },
    "contextId": { "$ref": "#/$defs/nonEmptyString" },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "executionReceipt": { "$ref": "review-report.schema.json#/$defs/executionReceiptReference" },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "passed", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "passed": { "type": "boolean" },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/artifactReference" }
          }
        }
      }
    },
    "verdict": { "enum": ["PASS", "FAIL", "BLOCKED"] }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
    "safeId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactPath", "sha256"],
      "properties": {
        "artifactPath": { "$ref": "#/$defs/nonEmptyString" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
