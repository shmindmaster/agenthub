{
  "schemaVersion": 2,
  "name": "full-access-unattended",
  "intent": "User-authorized local coding-agent profile with repository policy, registered MCPs, and managed capabilities available without routine permission prompts.",
  "canonicalPolicy": "C:/Repos/shmindmaster/agenthub/AGENTS.md",
  "managedHosts": [
    "claude",
    "codex",
    "cursor",
    "qwen-code",
    "opencode",
    "amp",
    "devin",
    "factory",
    "windsurf",
    "gemini",
    "copilot",
    "hermes",
    "grok",
    "antigravity",
    "warp",
    "cline",
    "qoder",
    "vscode-insiders"
  ],
  "launchDefaults": {
    "gemini": ["--yolo", "--skip-trust"],
    "copilot": ["--allow-all", "--autopilot", "--no-ask-user", "--allow-all-mcp-server-instructions"],
    "devin": ["--permission-mode", "dangerous", "--respect-workspace-trust", "false"],
    "agy": ["--dangerously-skip-permissions"],
    "cline": ["--auto-approve", "true"],
    "qoder": ["--dangerously-skip-permissions"]
  },
  "hostSettings": {
    "qwen-code": {
      "requiredModelGeneration": {
        "qwen3.8-max-preview": {
          "thinkingMandatory": true,
          "extra_body": {
            "enable_thinking": true
          }
        }
      }
    }
  },
  "dispatchPolicy": {
    "cursor": {
      "enabled": true,
      "scope": "ide-agent, local-cli, cloud-background-agent, api",
      "reason": "Owner explicitly reauthorized all Cursor surfaces on 2026-07-30. Health checks remain read-only and must not consume a paid run."
    }
  },
  "notes": [
    "OAuth consent and provider login remain provider-controlled.",
    "Active and inactive installation evidence is maintained only in registry/agents.json."
  ]
}
