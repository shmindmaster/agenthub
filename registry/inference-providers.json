{
  "schemaVersion": 1,
  "provider": {
    "id": "agenthub-daytona",
    "displayName": "AgentHub Daytona Spot",
    "baseUrl": "https://inference.shtrial.com/v1",
    "mediaBaseUrl": "https://inference.shtrial.com/v1/media",
    "anthropicBaseUrl": "https://inference.shtrial.com",
    "credentialEnv": "AGENTHUB_INFERENCE_KEY",
    "default": false,
    "preserveExistingDefaults": true,
    "protocols": {
      "chatCompletions": true,
      "responses": "conditional",
      "anthropicMessages": "conditional"
    },
    "deploymentPolicy": {
      "merge": true,
      "replaceExistingProviders": false,
      "changeDefaultModels": false,
      "changeExistingAgentAssignments": false
    }
  },
  "models": [
    {
      "id": "qwen3.8-27b-unc-q8",
      "displayName": "Qwen 3.8 27B (MXFP4)",
      "serving": {
        "engine": "vllm-rocm",
        "weights": "amd/Qwen3.8-27B-Quark-AWQ-MXFP4",
        "drafter": "incoai/Qwen3.8-27B-DFlash2",
        "precision": "MXFP4 (Quark AWQ) + DFlash2",
        "aiter": true,
        "measuredTokensPerSecond": 267.4,
        "measuredOn": "2026-11-26",
        "toolCallParser": "qwen3_coder",
        "reasoningParser": "qwen3",
        "note": "The retained model id still says q8 for compatibility with existing host entries; the served weights are amd/Qwen3.8-27B-Quark-AWQ-MXFP4 with incoai/Qwen3.8-27B-DFlash2 (num_speculative_tokens=7, kv-cache-dtype fp8, multimodal vision enabled). Steady-state MI355X measurement on 2026-11-26: 267.4 tok/s mean on-box (312.8 thinking) and 198.6 tok/s mean via gateway using AITER + 16-thread CPU cap (OMP_NUM_THREADS=16, MKL_NUM_THREADS=16, TOKENIZERS_PARALLELISM=false), up from 156.8 on-box on FP8+MTP and 81.1 baseline without speculation; image input + DFlash2 verified live via gateway (153.0 tok/s). For fast calls without reasoning, use the #fast variant or pass chat_template_kwargs: {\"enable_thinking\": false}."
      },
      "role": "general",
      "family": "qwen3.8",
      "contextWindow": 262144,
      "maxInputTokens": 229376,
      "maxOutputTokens": 32768,
      "streaming": true,
      "toolCalling": true,
      "structuredOutput": true,
      "modalities": {
        "input": [
          "text",
          "image"
        ],
        "output": [
          "text"
        ]
      },
      "reasoning": {
        "supported": true,
        "default": "medium",
        "supportedEfforts": [
          "low",
          "medium",
          "xhigh"
        ],
        "aliases": {
          "high": "medium"
        }
      }
    },
    {
      "id": "inkling2-min-26b-unc-q8-128k",
      "displayName": "Inkling 2 Mini 26B Q8 (128K)",
      "serving": {
        "engine": "llama-server-hip",
        "weights": "Abiray/Inkling-2-Mini-Uncensored-GGUF",
        "precision": "Q8_0",
        "measuredTokensPerSecond": 45.7,
        "measuredOn": "2026-11-26",
        "deferred": true,
        "note": "Deferred by the implementation playbook. The recipe launches no second server (FLAGSHIP_ENABLED=0) and no gateway backend is registered for this id, so it must not appear in a host picker yet."
      },
      "role": "general",
      "family": "inkling2",
      "contextWindow": 131072,
      "maxInputTokens": 98304,
      "maxOutputTokens": 32768,
      "streaming": true,
      "toolCalling": true,
      "structuredOutput": true,
      "modalities": {
        "input": [
          "text",
          "image"
        ],
        "output": [
          "text"
        ]
      },
      "reasoning": {
        "supported": true,
        "default": "medium",
        "supportedEfforts": [
          "low",
          "medium",
          "xhigh"
        ],
        "aliases": {
          "high": "medium"
        }
      }
    }
  ],
  "hosts": {
    "opencode": {
      "integration": "native-merge",
      "configPath": "{userHome}/.config/opencode/opencode.json",
      "schema": "opencode-v2-providers",
      "sharedWith": [
        "opencode-desktop"
      ],
      "credentialMode": "file-or-env-reference"
    },
    "codex": {
      "integration": "native-merge",
      "configPath": "{userHome}/.codex/config.toml",
      "profilePattern": "{userHome}/.codex/daytona-*.config.toml",
      "schema": "codex-toml-responses-standalone-profiles",
      "credentialMode": "env-reference",
      "protocolRequirement": "responses"
    },
    "factory": {
      "integration": "native-merge",
      "configPath": "{userHome}/.factory/settings.json",
      "canonicalSource": "packages/coding-agent-dispatch/factory/custom-models.json",
      "schema": "factory-custom-models",
      "credentialMode": "env-reference"
    },
    "grok": {
      "integration": "native-merge",
      "configPath": "{userHome}/.grok/config.toml",
      "schema": "grok-toml-models",
      "credentialMode": "env-reference"
    },
    "copilot": {
      "integration": "native-merge",
      "configPath": "{userHome}/.copilot/providers.json",
      "schema": "copilot-providers-json",
      "credentialMode": "protected-local-file"
    },
    "vscode-insiders": {
      "integration": "native-merge",
      "configPath": "{roamingConfig}/Code - Insiders/User/chatLanguageModels.json",
      "schema": "vscode-chat-language-models",
      "credentialMode": "input-env-reference"
    },
    "kilo": {
      "integration": "native-merge",
      "configPath": "{userHome}/.config/kilo/kilo.jsonc",
      "schema": "kilo-jsonc-provider",
      "credentialMode": "env-reference"
    },
    "cline": {
      "integration": "native-merge",
      "configPath": "{userHome}/.cline/data/settings/providers.json",
      "schema": "cline-openai-compatible-provider",
      "credentialMode": "protected-local-file"
    },
    "zcode": {
      "integration": "native-merge",
      "configPath": "{userHome}/.zcode/v2/provider_config.json",
      "schema": "zcode-v2-provider-config",
      "credentialMode": "protected-local-file"
    },
    "amp": {
      "integration": "native-cli-router",
      "configPath": "{userHome}/.config/amp/settings.json",
      "schema": "amp-custom-url-router",
      "credentialMode": "cli-secret-store"
    },
    "autoclaw": {
      "integration": "manual-ui",
      "notes": "Standalone ZCode profile must not be copied into AutoClaw. Add https://inference.shtrial.com/v1 through Settings -> Models & API -> Add custom model."
    },
    "claude": {
      "integration": "delegation-only",
      "notes": "Preserve native Claude subscription and auth. Anthropic does not support routing Claude Code to non-Claude models globally; delegate via AgentHub."
    },
    "cursor": {
      "integration": "delegation-only",
      "sharedWith": [
        "cursor-agent"
      ],
      "notes": "BYOK overrides or conflicts with native subscription model routing across IDE/CLI surfaces. Preserve native subscription and delegate via AgentHub."
    },
    "devin": {
      "integration": "delegation-only",
      "notes": "Devin Desktop/CLI config.json does not support arbitrary OpenAI-compatible external endpoints. Preserve swe-2-medium and delegate via AgentHub."
    },
    "antigravity": {
      "integration": "delegation-only",
      "sharedWith": [
        "antigravity-desktop",
        "antigravity-ide"
      ],
      "notes": "No documented independent OpenAI-compatible custom-provider schema; preserve native models and delegate via AgentHub."
    }
  }
}
