    "deferred": [],
    "outOfScope": [
      { "id": "detox", "name": "Detox", "reason": "Unsupported by the adopted Expo and React Native stack and requires a separate instrumented build." },
      { "id": "maestro-mcp", "name": "Maestro MCP", "reason": "The native Maestro CLI already runs committed flows; another persistent MCP duplicates Appium and adds process cost." },
      { "id": "wsl-android-e2e", "name": "WSL Android E2E", "reason": "The Windows-native or guest reverse-tunnel routes are measured working; WSL adds a second inferior toolchain." },
      { "id": "android-studio", "name": "Android Studio", "reason": "CLI SDK and AVD tooling is sufficient and avoids a second bundled JDK." },
      { "id": "nested-virtualization", "name": "Nested virtualization", "reason": "The macOS guest does not need nested VMs and the working VM configuration keeps vhv.enable false." },
      { "id": "second-vm-nic", "name": "Second VM NIC", "reason": "VMnet8 NAT already provides host-private reachability and a second NIC adds address ambiguity." },
      { "id": "routine-cloud-builds", "name": "Routine cloud builds", "reason": "Android APKs and iOS Simulator builds compile locally; cloud builds are a gated fallback, not the routine path." },
      { "id": "cloud-device-farms", "name": "Cloud device farms", "reason": "The canonical lab uses local virtual devices; paid external device farms are outside this capability." }
    ]
  }
