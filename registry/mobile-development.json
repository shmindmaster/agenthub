  "resources": [
    {
      "id": "mobile-scope-registry",
      "kind": "registry",
      "path": "registry/mobile-scope.json",
      "discovery": "read-json"
    },
    {
      "id": "windows-mobile-toolchain",
      "kind": "host-toolchain",
      "platform": "windows",
      "discovery": {
        "androidSdkEnvironment": ["ANDROID_HOME", "ANDROID_SDK_ROOT"],
        "adbRelativePath": "platform-tools/adb.exe",
        "emulatorRelativePath": "emulator/emulator.exe",
        "nodeCommand": "node",
        "javaEnvironment": "JAVA_HOME",
        "javaRelativePath": "bin/java.exe",
        "javaFallbackCommand": "java"
      }
    },
    {
      "id": "windows-hypervisor-platform",
      "kind": "acceleration-substrate",
      "platform": "windows",
      "provider": "WHP/WHPX",
      "readiness": "The Android emulator's acceleration check reports WHPX usable; this is not a separate mobile lane."
    },
    {
      "id": "vmware-workstation",
      "kind": "hypervisor",
      "platform": "windows",
      "discovery": {
        "vmrunPaths": [
          "C:/Program Files/VMware/VMware Workstation/vmrun.exe",
          "C:/Program Files (x86)/VMware/VMware Workstation/vmrun.exe"
        ]
      }
    },
    {
      "id": "macos-guest-vm",
      "kind": "virtual-machine",
      "providerId": "vmware-workstation",
      "vmxAuthorityRef": "authorities.vmx",
      "hardwareDiscovery": {
        "source": "vmx-live",
        "fields": ["numvcpus", "memsize"],
        "recordValuesHere": false
      },
      "network": "VMnet8 NAT",
      "sshHostAlias": "macvm"
    },
    {
      "id": "macos-guest-known-good-backup",
      "kind": "immutable-backup",
      "path": "D:/VMs/macOS-Tahoe-AMD-Backup-2026-08-10",
      "mutationAllowed": false
    },
    {
      "id": "android-avd",
      "kind": "virtual-device",
      "platform": "android",
      "expectationRef": "expectations.android",
      "providerId": "windows-mobile-toolchain"
    },
    {
      "id": "ios-simulator",
      "kind": "virtual-device",
      "platform": "ios",
      "expectationRef": "expectations.ios",
      "providerId": "macos-guest-vm"
    }
  ],
  "services": [
    {
      "id": "adb",
      "activationMode": "on-demand-local",
      "invocation": "<android-sdk>/platform-tools/adb.exe",
      "readiness": "An existing adb server process and an API-level-matching emulator are reported; read-only checks never start adb."
    },
    {
      "id": "metro",
      "activationMode": "explicit-local",
      "invocation": "packages/mobile-development/skills/mobile-device-lab/scripts/Start-MobileLabMetro.ps1",
      "readiness": "HTTP /status returns packager-status:running on the selected port."
    },
    {
      "id": "ssh",
      "activationMode": "command-on-demand",
      "invocation": "ssh -o HostKeyAlias=macvm macvm",
      "readiness": "TCP port 22 is reachable at a dynamically resolved guest address."
    },
    {
      "id": "guest-appium",
      "activationMode": "guest-launchd-after-vm-start",
      "invocation": "packages/mobile-development/skills/mobile-device-lab/scripts/guest/start-appium-guest.sh",
      "readiness": "expectations.guestAppium.statusPath returns value.ready=true on the private VMnet8 address."
    },
    {
      "id": "appium-mcp",
      "activationMode": "on-demand-local",
      "mcpServerId": "appium-mobile",
      "mcpAuthority": "registry/mcps.json",
      "hosts": ["claude", "codex"],
      "invocation": "mobile.ps1 mcp enable <claude|codex>",
      "readiness": "A newly loaded host task exposes the Appium MCP tool catalog; disable it after mobile work."
    }
  ],
