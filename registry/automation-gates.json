{
  "schemaVersion": 1,
  "policy": "automation-first-evidence-gates",
  "purpose": "Replace discretionary process gates with reproducible evidence and deterministic decisions while preserving controls for lawful authority and irreversible external effects.",
  "decisionClasses": {
    "machine": {
      "defaultAction": "auto_proceed",
      "requiredEvidence": ["versioned source", "deterministic test or invariant", "reproducible receipt"],
      "useFor": ["build", "unit and contract validation", "security checks", "release artifacts"]
    },
    "automated_evidence": {
      "defaultAction": "go_pivot_or_stop",
      "requiredEvidence": ["source provenance", "predeclared threshold", "freshness check", "falsification result"],
      "useFor": ["market research", "PMF proxies", "benchmarking", "pricing", "evaluation"]
    },
    "accountable_external_action": {
      "defaultAction": "draft_only",
      "requiredEvidence": ["authority scope", "identity or contract record", "immutable audit receipt"],
      "useFor": ["contracts", "payments", "regulatory filings", "live-data authorization", "binding communications"]
    },
    "fail_closed_exception": {
      "defaultAction": "halt_and_queue",
      "requiredEvidence": ["reason code", "supporting evidence", "scope-limited resolution"],
      "useFor": ["ambiguous inputs", "safety limits", "conflicting authority", "unverifiable claims"]
    }
  },
  "portfolio": [
    {
      "id": "warrantygains",
      "automate": ["source freshness", "demand and pricing signals", "evidence completeness", "preflight consistency"],
      "retain": ["dealer engagement", "OEM submission", "legal or compliance conclusion"],
      "defaultDecisionClass": "automated_evidence"
    },
    {
      "id": "abacare",
      "automate": ["AI regression evaluation", "policy source monitoring", "minimum-necessary checks", "release canaries"],
      "retain": ["lawful real-PHI authority", "parent or payer commitment", "externally binding care action"],
      "defaultDecisionClass": "fail_closed_exception"
    },
    {
      "id": "agenthub",
      "automate": ["registry validation", "capability ownership", "configuration drift detection", "local contract checks"],
      "retain": ["provider activation", "OAuth or credential creation", "cross-boundary operational decisions"],
      "defaultDecisionClass": "machine"
    },
    {
      "id": "coledger",
      "automate": ["public-signal research", "synthetic benchmark evaluation", "close and reconciliation invariants", "evidence receipts"],
      "retain": ["data-sharing authority", "paid pilot commitment", "financial attestation"],
      "defaultDecisionClass": "automated_evidence"
    },
    {
      "id": "crewscore",
      "automate": ["merge gates", "release tags", "corpus validity", "distribution drafts", "public-product signals"],
      "retain": ["PyPI publisher binding", "security exploit triage", "optional third-party account creation"],
      "defaultDecisionClass": "machine"
    },
    {
      "id": "gentlenext",
      "automate": ["demand synthesis", "synthetic benchmark evaluation", "source provenance", "release checks"],
      "retain": ["data or pilot agreement", "real-PHI authority", "binding care-delivery action"],
      "defaultDecisionClass": "automated_evidence"
    },
    {
      "id": "lawli",
      "automate": ["citation and deadline QA", "claim-provenance evaluation", "source freshness", "read-only contract testing"],
      "retain": ["case-specific legal strategy", "representation or filing", "confidential-matter authorization"],
      "defaultDecisionClass": "fail_closed_exception"
    },
    {
      "id": "lexalign",
      "automate": ["matter isolation tests", "claim benchmarks", "read-only API contract checks", "market-document evidence"],
      "retain": ["legal judgment", "matter-scoped authorization", "binding partner contract"],
      "defaultDecisionClass": "fail_closed_exception"
    },
    {
      "id": "repocontext",
      "automate": ["index integrity", "sensitive-path denial", "retrieval contract checks", "freshness receipts"],
      "retain": ["production endpoint authorization", "credential provisioning", "source-access approval"],
      "defaultDecisionClass": "machine"
    },
    {
      "id": "sabhi",
      "automate": ["intake classification", "draft generation", "inventory and policy provenance", "transaction invariant checks"],
      "retain": ["money movement", "inventory or delivery promise", "outbound commitment"],
      "defaultDecisionClass": "fail_closed_exception"
    },
    {
      "id": "subops",
      "automate": ["source ingestion", "reconciliation", "extraction and math evaluation", "demand evidence", "draft evidence packets"],
      "retain": ["carrier dispute submission", "real-data permission", "financial statement of record"],
      "defaultDecisionClass": "fail_closed_exception"
    },
    {
      "id": "verigence",
      "automate": ["demand signals", "synthetic case generation", "AI evaluation", "policy monitoring", "canary analysis"],
      "retain": ["real-PHI authority", "consent", "payer or provider transaction", "external commercial commitment"],
      "defaultDecisionClass": "fail_closed_exception"
    }
  ],
  "guardrails": [
    "No interview, workshop, or discretionary review count is a release prerequisite.",
    "Automated proxy evidence must identify its construct, limitations, and falsification threshold.",
    "Synthetic evidence never proves a live customer, clinical, financial, legal, or commercial outcome.",
    "A machine may prepare a draft for an accountable external action but may not infer authority or execute outside its configured scope.",
    "Uncertain, conflicting, stale, or unsupported evidence halts the affected action with a reason code."
  ]
}
