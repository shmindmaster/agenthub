{
  "schemaVersion": 1,
  "canonicalPackage": {
    "manifest": ".claude-plugin/plugin.json",
    "skills": "skills/*/SKILL.md",
    "agents": "agents/*.agent.md",
    "mcp": ".mcp.json"
  },
  "hosts": [
    {
      "id": "claude",
      "mode": "native-claude-package",
      "manifest": ".claude-plugin/plugin.json",
      "globalSkillsDir": "~/.claude/skills",
      "subagents": "agents/*.md in plugin",
      "mcpPath": "~/.claude.json",
      "mcpKey": "mcpServers",
      "documentation": "https://code.claude.com/docs/en/plugin-marketplaces",
      "verifiedAgainst": "https://code.claude.com/docs/en/plugin-marketplaces"
    },
    {
      "id": "codex",
      "mode": "native-codex-package",
      "manifest": ".codex-plugin/plugin.json",
      "globalSkillsDir": "~/.agents/skills",
      "subagents": "unverified",
      "mcpPath": "~/.codex/config.toml",
      "mcpKey": "[mcp_servers.<id>]",
      "documentation": "https://learn.chatgpt.com/docs/build-skills",
      "verifiedAgainst": "https://learn.chatgpt.com/docs/build-skills",
      "correctedAt": "2026-08-04",
      "correctionNote": "globalSkillsDir was recorded as ~/.codex/skills from the plugins page, which does not cover skill discovery. Codex's skills documentation lists REPO ($CWD/.agents/skills, $CWD/../.agents/skills, $REPO_ROOT/.agents/skills), USER ($HOME/.agents/skills), ADMIN (/etc/codex/skills) and bundled SYSTEM skills, and names no ~/.codex/skills tier. ~/.codex/config.toml remains correct for MCP and for [[skills.config]] entries."
    },
    {
      "id": "cursor",
      "mode": "native-cursor-package",
      "manifest": ".cursor-plugin/plugin.json",
      "globalSkillsDir": "~/.cursor/skills",
      "subagents": "unverified",
      "mcpPath": "~/.cursor/mcp.json",
      "mcpKey": "mcpServers",
      "documentation": "https://cursor.com/docs",
      "verifiedAgainst": "https://cursor.com/docs"
    },
    {
      "id": "factory",
      "mode": "auto-translates-claude-package",
      "manifest": null,
      "documentation": "https://docs.factory.ai/harness/plugins",
      "globalSkillsDir": "~/.factory/skills",
      "subagents": "droids/*.md",
      "mcpPath": "~/.factory/mcp.json",
      "mcpKey": "mcpServers",
      "verifiedAgainst": "https://docs.factory.ai/harness/plugins"
    },
    {
      "id": "vscode-insiders",
      "mode": "auto-detects-claude-package",
      "manifest": null,
      "documentation": "https://code.visualstudio.com/docs/agent-customization/agent-plugins",
      "globalSkillsDir": null,
      "subagents": "via plugin",
      "mcpPath": "%APPDATA%/Code - Insiders/User/mcp.json",
      "mcpKey": "servers",
      "verifiedAgainst": "https://code.visualstudio.com/docs/agent-customization/agent-plugins"
    },
    {
      "id": "qwen-code",
      "mode": "auto-converts-claude-marketplace-package",
      "manifest": null,
      "documentation": "https://qwenlm.github.io/qwen-code-docs/en/users/extension/introduction/",
      "globalSkillsDir": "~/.qwen/skills",
      "subagents": "agents/ in extension",
      "mcpPath": "~/.qwen/settings.json",
      "mcpKey": "mcpServers",
      "verifiedAgainst": "https://qwenlm.github.io/qwen-code-docs/en/users/extension/introduction/"
    },
    {
      "id": "copilot",
      "mode": "native-root-package",
      "manifest": "plugin.json",
      "documentation": "https://docs.github.com/en/copilot/concepts/agents/about-plugins",
      "globalSkillsDir": "~/.copilot/skills",
      "subagents": "via plugin",
      "mcpPath": "~/.copilot/mcp-config.json",
      "mcpKey": "mcpServers",
      "verifiedAgainst": "https://docs.github.com/en/copilot/concepts/agents/about-plugins"
    },
    {
      "id": "antigravity",
      "mode": "native-root-package",
      "manifest": "plugin.json",
      "documentation": "https://antigravity.google/docs/cli/plugins",
      "globalSkillsDir": "~/.gemini/config/skills",
      "subagents": "unverified",
      "mcpPath": "~/.gemini/config/mcp_config.json",
      "mcpKey": "mcpServers",
      "verifiedAgainst": "https://antigravity.google/docs/cli/plugins"
    },
    {
      "id": "qoder",
      "mode": "native-qoder-package",
      "manifest": ".qoder-plugin/plugin.json",
      "documentation": "https://docs.qoder.com/en/cli/Skills",
      "globalSkillsDir": "~/.qoder/skills",
      "subagents": "agents/*.md",
      "mcpPath": "~/.qoder/settings.json",
      "mcpKey": "mcpServers",
      "verifiedAgainst": "https://docs.qoder.com/en/cli/Skills"
    },
    {
      "id": "devin",
      "mode": "auto-falls-back-to-claude-package",
      "manifest": null,
      "note": "A native .devin-plugin manifest is optional because Devin documents Claude-package fallback.",
      "documentation": "https://docs.devin.ai/product-guides/plugins",
      "globalSkillsDir": "%APPDATA%/devin/skills",
      "subagents": "unverified",
      "mcpPath": "%APPDATA%/devin/config.json",
      "mcpKey": "mcpServers",
      "verifiedAgainst": "https://docs.devin.ai/product-guides/plugins"
    },
    {
      "id": "grok",
      "mode": "auto-reads-claude-package",
      "manifest": null,
      "documentation": "https://docs.x.ai/build/features/skills-plugins-marketplaces",
      "globalSkillsDir": "~/.grok/skills",
      "subagents": "unverified",
      "mcpPath": "~/.grok/config.toml",
      "mcpKey": "[mcp_servers.<id>]",
      "verifiedAgainst": "grok plugin --help (CLI, 2026-08-03)"
    },
    {
      "id": "opencode",
      "mode": "loose-skills-agents-and-mcp",
      "manifest": null,
      "note": "OpenCode plugins are executable JavaScript or TypeScript hooks, not capability bundle manifests.",
      "documentation": "https://opencode.ai/docs/plugins/",
      "globalSkillsDir": "~/.config/opencode/skills",
      "subagents": "agents/",
      "mcpPath": "~/.config/opencode/opencode.json",
      "mcpKey": "mcp",
      "verifiedAgainst": "https://opencode.ai/docs/plugins/"
    },
    {
      "id": "amp",
      "mode": "loose-skills-and-mcp",
      "manifest": null,
      "globalSkillsDir": "~/.config/amp/skills",
      "subagents": "spawned automatically; not user-declared",
      "mcpPath": "~/.config/amp/settings.json",
      "mcpKey": "amp.mcpServers",
      "documentation": "https://ampcode.com/manual",
      "verifiedAgainst": "https://ampcode.com/manual"
    },
    {
      "id": "cline",
      "mode": "loose-skills-and-mcp",
      "manifest": null,
      "globalSkillsDir": "~/.cline/skills",
      "subagents": "unverified",
      "mcpPath": "~/.cline/data/settings/cline_mcp_settings.json",
      "mcpKey": "mcpServers",
      "documentation": "https://docs.cline.bot/features/skills",
      "verifiedAgainst": "https://docs.cline.bot/features/skills"
    },
    {
      "id": "gemini",
      "mode": "loose-skills-and-mcp",
      "manifest": null,
      "globalSkillsDir": "~/.gemini/skills",
      "subagents": "agents/*.md in extension (preview)",
      "mcpPath": "~/.gemini/settings.json",
      "mcpKey": "mcpServers",
      "documentation": "https://geminicli.com/docs/extensions/reference/",
      "verifiedAgainst": "https://geminicli.com/docs/extensions/reference/"
    },
    {
      "id": "hermes",
      "mode": "loose-skills-and-mcp",
      "manifest": null,
      "globalSkillsDir": "%LOCALAPPDATA%/hermes/skills",
      "subagents": "unverified",
      "mcpPath": "%LOCALAPPDATA%/hermes/config.yaml",
      "mcpKey": "mcp_servers",
      "documentation": "local install inspection (2026-08-03)",
      "verifiedAgainst": "local install inspection (2026-08-03)"
    },
    {
      "id": "warp",
      "mode": "loose-skills-and-mcp",
      "manifest": null,
      "globalSkillsDir": "~/.agents/skills",
      "alsoScannedSkillsDirs": ["~/.warp/skills", "~/.claude/skills", "~/.codex/skills", "~/.cursor/skills", "~/.gemini/skills", "~/.copilot/skills", "~/.factory/skills", "~/.github/skills", "~/.opencode/skills"],
      "subagents": "skills-as-agents",
      "mcpPath": "~/.warp/.mcp.json",
      "mcpKey": "mcpServers",
      "documentation": "https://docs.warp.dev/agent-platform/capabilities/skills/",
      "verifiedAgainst": "https://docs.warp.dev/agent-platform/capabilities/skills/",
      "correctedAt": "2026-08-04",
      "correctionNote": "globalSkillsDir was ~/.warp/skills. That path is real and still documented, but recording it alone understated what the same page says: Warp mirrors its multi-tool project search at root scope and names ~/.agents/skills first as recommended. Warp is the only host in this fleet that reads other hosts' skill directories, so a private ~/.warp/skills copy duplicated skills Warp could already see via ~/.claude/skills and the rest. alsoScannedSkillsDirs records the full documented set so a future reader does not have to re-derive it."
    },
    {
      "id": "windsurf",
      "mode": "loose-skills-and-mcp",
      "manifest": null,
      "globalSkillsDir": "~/.codeium/windsurf/skills",
      "subagents": "unverified",
      "mcpPath": "~/.codeium/windsurf/mcp_config.json",
      "mcpKey": "mcpServers",
      "documentation": "https://docs.windsurf.com/windsurf/cascade/skills",
      "verifiedAgainst": "https://docs.windsurf.com/windsurf/cascade/skills",
      "correctedAt": "2026-08-04",
      "correctionNote": "globalSkillsDir was recorded as null because the earlier research verified windsurf against its MCP page, which says nothing about skills; absence of evidence on an unrelated page became evidence of absence. Windsurf's own skills page documents three scopes -- Workspace .windsurf/skills/, Global ~/.codeium/windsurf/skills/, and System (Enterprise) -- so the ~31 skills deployed at that path are reachable, not inert. This reversed a planned prune of them."
    }
  ],
  "researchedAt": "2026-08-03",
  "fieldNotes": {
    "globalSkillsDir": "Home-scope skills directory the host actually reads. null means the host documents project-scope skills only, so a home-directory deployment is inert.",
    "subagents": "How the host consumes subagent role files. 'unverified' means the host's documentation was not confirmed; do not assume the AgentHub agents/ tree loads there.",
    "mcpKey": "Property (JSON) or section shape (TOML/YAML) that holds MCP server entries.",
    "multiDirectoryReaders": "Warp and Amp both scan several home skill directories, so per-host skill copies are enumerated repeatedly by those two hosts. See fleetNotes."
  },
  "fleetNotes": [
    "Warp reads ~/.agents/skills, ~/.warp/skills, ~/.claude/skills, ~/.codex/skills, ~/.cursor/skills, ~/.gemini/skills, ~/.copilot/skills, ~/.factory/skills, ~/.github/skills, and ~/.opencode/skills. With one copy deployed per host, Warp enumerated 185 entries for 53 distinct skills on 2026-08-03.",
    "Amp skill precedence is ~/.config/agents/skills, then ~/.agents/skills, then ~/.config/amp/skills. A single shared deployment under ~/.agents/skills would satisfy Amp, Warp, Cline, Gemini, and Codex without per-host duplication.",
    "windsurf has no documented global skills directory; the managed deployment under ~/.codeium/windsurf/skills is inert.",
    "Neither Sync-AgentHub.ps1 nor Sync-Capabilities.ps1 deploys subagents. agentsDir is never a deployment target, so loose-skill hosts receive skills but no agents/ roles."
  ]
}
