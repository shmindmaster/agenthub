{
  "schemaVersion": 1,
  "sessionFreshness": {
    "versionedCapabilities": [
      {
        "capabilityId": "product-demo-studio",
        "manifestPaths": [
          ".claude-plugin/plugin.json",
          ".codex-plugin/plugin.json",
          ".qoder-plugin/plugin.json"
        ]
      }
    ],
    "staleSessionStatus": "WARN",
    "restartRequired": true
  },
  "resourceBudgets": [
    {
      "id": "codex-runtime",
      "commandLinePattern": "(?i)codex|chatgpt",
      "warningWorkingSetMb": 4096,
      "warningProcessCount": 48
    },
    {
      "id": "claude-runtime",
      "commandLinePattern": "(?i)claude|cowork",
      "warningWorkingSetMb": 4096,
      "warningProcessCount": 40
    },
    {
      "id": "language-servers",
      "commandLinePattern": "(?i)language-server|typescript-language-server|pyright",
      "warningWorkingSetMb": 2048,
      "warningProcessCount": 20
    },
    {
      "id": "local-mcp-workers",
      "commandLinePattern": "(?i)playwright-mcp|chrome-devtools-mcp|brave-search-mcp|context7-mcp|firecrawl-mcp|repocontext.+mcp",
      "warningWorkingSetMb": 1536,
      "warningProcessCount": 12
    }
  ],
  "enforcement": {
    "autoTerminate": false,
    "reason": "Resource evidence is advisory. Process ownership must be traced before any termination so one host cannot kill another host's runtime."
  }
}
