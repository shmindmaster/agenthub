{
  "name": "agenthub",
  "description": "AgentHub shared capability catalog. Every plugin is named ah-<capability> so AgentHub plugins sort together in each host.",
  "owner": {
    "name": "MahumTech"
  },
  "renames": {
    "product": "ah-product",
    "mobile-development": "ah-mobile-development",
    "media-studio": "ah-media-studio",
    "assemblyai": "ah-assemblyai",
    "brave-search": "ah-brave-search",
    "browser": "ah-browser"
  },
  "plugins": [
    {
      "name": "ah-product",
      "displayName": "AH-Product",
      "source": "./packages/product"
    },
    {
      "name": "ah-mobile-development",
      "displayName": "AH-Mobile-Development",
      "source": "./packages/mobile-development"
    },
    {
      "name": "ah-media-studio",
      "displayName": "AH-Media-Studio",
      "source": "./packages/media-studio"
    },
    {
      "name": "ah-assemblyai",
      "displayName": "AH-AssemblyAI",
      "source": "./packages/assemblyai"
    },
    {
      "name": "ah-brave-search",
      "displayName": "AH-Brave-Search",
      "source": "./packages/brave-search"
    },
    {
      "name": "ah-browser",
      "displayName": "AH-Browser",
      "source": "./packages/browser"
    },
    {
      "name": "ah-descript",
      "displayName": "AH-Descript",
      "source": "./packages/descript"
    },
    {
      "name": "ah-coding-agent-dispatch",
      "displayName": "AH-Coding-Agent-Dispatch",
      "source": "./packages/coding-agent-dispatch"
    },
    {
      "name": "ah-funding",
      "displayName": "AH-Funding",
      "source": "./packages/funding"
    }
  ]
}
